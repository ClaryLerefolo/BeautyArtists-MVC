@using BeautyArtists.Models
@model BeautyArtists.Models.ViewModels.BookingViewModel
@{
    ViewData["Title"] = "Book Service";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<div class="book-page">

    @* ── HERO ── *@
    <div class="book-hero">
        <div class="book-hero-glow"></div>
        <div class="container book-hero-inner">
            <div class="book-service-info">
                <span class="book-eyebrow">You're booking</span>
                <h1 class="book-service-name">@Model.ServiceName</h1>
                <div class="book-artist-line">
                    <span class="book-artist-label">with</span>
                    <span class="book-artist-name">@Model.ArtistName</span>
                </div>
                @if (Model.IsNewClient)
                {
                    <span class="client-tag new-client">New Client</span>
                }
                else
                {
                    <span class="client-tag repeat-client">Repeat Client</span>
                }
            </div>
        </div>
    </div>

    <div class="container book-body">

        @* ── SERVER-SIDE VALIDATION SUMMARY ── *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="book-server-errors">
                <strong>Please fix the following issues:</strong>
                <ul>
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        foreach (var error in modelState.Errors)
                        {
                            if (!string.IsNullOrEmpty(error.ErrorMessage))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    }
                </ul>
            </div>
        }

        <form asp-controller="Booking" asp-action="ConfirmBooking" method="post" id="bookingForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserServiceId" value="@Model.UserServiceId" />
            <input type="hidden" name="ArtistId" value="@Model.ArtistId" />
            <input type="hidden" name="Price" value="@Model.Price" />
            <input type="hidden" name="ServiceName" value="@Model.ServiceName" />
            <input type="hidden" name="ArtistName" value="@Model.ArtistName" />
            <input type="hidden" name="IsNewClient" value="@Model.IsNewClient.ToString()" />

            @* ─── HIDDEN FIELDS (populated by modal) ─── *@
            <input type="hidden" name="AvailabilitySlotId" id="AvailabilitySlotId" value="@Model.AvailabilitySlotId" />
            <input type="hidden" name="PreferredDate" id="PreferredDate" value="@Model.PreferredDate.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="Latitude" id="Latitude" value="@Model.Latitude" />
            <input type="hidden" name="Longitude" id="Longitude" value="@Model.Longitude" />
            <input type="hidden" name="HouseNumber" id="HouseNumber" value="@Model.HouseNumber" />
            <input type="hidden" name="StreetAddress" id="StreetAddress" value="@Model.StreetAddress" />
            <input type="hidden" name="AreaCode" id="AreaCode" value="@Model.AreaCode" />
            <input type="hidden" name="HouseCallAddress" id="HouseCallAddress" value="@Model.HouseCallAddress" />

            @* ── STEP 1: CALENDAR ── *@
            <div class="book-section">
                <div class="book-step-header">
                    <div class="book-step-num">1</div>
                    <div>
                        <h2 class="book-step-title">Choose a Date &amp; Time</h2>
                        <p class="book-step-sub">Gold dates have available slots — click to see times</p>
                    </div>
                </div>

                <div id="calLoading" class="slots-loading">
                    <div class="slots-spinner"></div>
                    <span>Loading availability...</span>
                </div>

                <div id="calEmpty" class="slots-empty" style="display:none">
                    <div class="slots-empty-icon">📅</div>
                    <p>This artist has no available slots right now.</p>
                    <small>Check back soon or contact them directly.</small>
                </div>

                <div id="calendarWrap" style="display:none">
                    <div class="cal-nav">
                        <button type="button" class="cal-nav-btn" id="prevMonth">◀</button>
                        <span class="cal-month-label" id="monthLabel"></span>
                        <button type="button" class="cal-nav-btn" id="nextMonth">▶</button>
                    </div>
                    <div class="cal-grid cal-headers">
                        <div class="cal-day-header">Sun</div>
                        <div class="cal-day-header">Mon</div>
                        <div class="cal-day-header">Tue</div>
                        <div class="cal-day-header">Wed</div>
                        <div class="cal-day-header">Thu</div>
                        <div class="cal-day-header">Fri</div>
                        <div class="cal-day-header">Sat</div>
                    </div>
                    <div class="cal-grid" id="calDays"></div>
                    <div id="timeSlotSection" style="display:none">
                        <div class="cal-time-header">Available times for <strong id="selectedDateLabel"></strong></div>
                        <div class="time-slots-grid" id="timeSlotsGrid"></div>
                    </div>
                </div>
                <div id="slotError" class="book-field-error" style="display:none">Please select a date and time to continue.</div>
            </div>

            @* ── STEP 2: LOCATION TYPE ── *@
            <div class="book-section">
                <div class="book-step-header">
                    <div class="book-step-num">2</div>
                    <div>
                        <h2 class="book-step-title">Select Appointment Location</h2>
                        <p class="book-step-sub">Choose between a salon studio visit or mobile home service</p>
                    </div>
                </div>

                <div class="location-options-container">
                    <div class="location-card" id="cardWalkIn">
                        @Html.RadioButtonFor(m => m.SelectedLocationType, LocationType.WalkIn, new { id = "locWalkIn", @class = "location-radio" })
                        <div class="card-content">
                            <div class="card-icon">🏢</div>
                            <div class="card-text">
                                <h3>Walk-In</h3>
                                <p>At the artist's studio/salon.</p>
                            </div>
                        </div>
                        <div class="radio-indicator"></div>
                    </div>
                    <div class="location-card" id="cardHouseCall">
                        @Html.RadioButtonFor(m => m.SelectedLocationType, LocationType.HouseCall, new { id = "locHouseCall", @class = "location-radio" })
                        <div class="card-content">
                            <div class="card-icon">📍</div>
                            <div class="card-text">
                                <h3>House Call</h3>
                                <p>Artist travels out to your doorstep.</p>
                            </div>
                        </div>
                        <div class="radio-indicator"></div>
                    </div>
                </div>
                <span asp-validation-for="SelectedLocationType" class="text-danger small"></span>

                <!-- ─── TRIGGER BUTTON (shows when House Call is selected) ─── -->
                <div id="houseCallTrigger" style="display:none; margin-top:16px;">
                    <button type="button" class="btn btn-warning w-100 py-2" id="openHouseCallModal">
                        <i class="fas fa-map-pin me-2"></i> Enter House Call Details
                    </button>
                </div>
            </div>

            @* ── STEP 3: NOTES ── *@
            <div class="book-section">
                <div class="book-step-header">
                    <div class="book-step-num">3</div>
                    <div>
                        <h2 class="book-step-title">Any Special Requests?</h2>
                        <p class="book-step-sub">Optional — tell the artist anything they should know</p>
                    </div>
                </div>
                <textarea asp-for="Notes" class="book-textarea" placeholder="e.g. I prefer natural looks, I have sensitive skin..." rows="3"></textarea>
            </div>

            @* ── STEP 4: SUMMARY WITH PRICE BLOCK ── *@
            <div class="book-section book-summary" id="bookSummary" style="display:none">
                <div class="book-summary-row"><span>Service</span><strong>@Model.ServiceName</strong></div>
                <div class="book-summary-row"><span>Artist</span><strong>@Model.ArtistName</strong></div>
                <div class="book-summary-row"><span>Appointment Type</span><strong id="summaryLocationType">Walk-In</strong></div>
                <div class="book-summary-row"><span>Date &amp; Time</span><strong id="summarySlot">—</strong></div>

                <!-- ─── PRICE BREAKDOWN ─── -->
                <div class="book-summary-row" style="border-top: 1px solid rgba(255,215,0,0.15); padding-top: 12px; margin-top: 4px;">
                    <span>Service Price</span>
                    <strong>R @Model.Price.ToString("N2")</strong>
                </div>
                <div class="book-summary-row">
                    <span style="color: rgba(255,255,255,0.5);">Card Processing Fee (4%)</span>
                    <strong style="color: #ff6600;">R @Model.CardProcessingFee.ToString("N2")</strong>
                </div>
                <div class="book-summary-row" style="border-bottom: 1px solid rgba(255,215,0,0.15);">
                    <span style="color: rgba(255,255,255,0.5);">Booking Fee</span>
                    <strong style="color: rgba(255,215,0,0.7);">R @Model.BookingFee.ToString("N2")</strong>
                </div>
                <div class="book-summary-row book-summary-total" style="border-bottom: none; padding-bottom: 0;">
                    <span style="color: #FFD700; font-weight: 800;">Total You Pay</span>
                    <strong style="color: #FFD700; font-size: 1.2rem;">R @Model.ClientTotal.ToString("N2")</strong>
                </div>

                <!-- ─── ACKNOWLEDGMENT CHECKBOX ─── -->
                <div style="margin-top: 16px; padding: 14px 16px; background: rgba(255,215,0,0.04); border-radius: 10px; border-left: 3px solid #FFD700;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="hasAgreedToTerms" name="HasAgreedToTerms" value="true" style="accent-color: #FFD700; width: 18px; height: 18px; border: 2px solid rgba(255,215,0,0.3);" />
                        <label class="form-check-label" for="hasAgreedToTerms" style="color: rgba(255,255,255,0.7); font-size: 0.8rem; line-height: 1.4;">
                            By confirming this booking I agree that I have read, understood and agree with the terms and conditions of the attached <a href="#" onclick="openPolicyModal(event); return false;" style="color: #FFD700; text-decoration: underline;">cancellation policy</a>.
                        </label>
                    </div>
                    <div id="agreeError" class="book-field-error" style="display:none; margin-top: 8px;">
                        You must agree to the terms before booking.
                    </div>
                </div>

                <div class="travel-cost-disclaimer" id="travelDisclaimer" style="display:none">Transport costs for house calls are calculated and added by your artist when reviewing the request.</div>
            </div>

            <button type="submit" class="book-confirm-btn">Confirm Booking Request</button>
        </form>
    </div>
</div>

@* ─── CANCELLATION POLICY MODAL ─── *@
<div class="modal fade" id="policyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="background: #0a0a0a; border: 1px solid rgba(255,215,0,0.2); border-radius: 16px;">
            <div class="modal-header" style="border-bottom: 1px solid rgba(255,215,0,0.1); padding: 20px 24px;">
                <h5 class="modal-title" style="color: #d4a843; font-weight: 700; font-size: 1.1rem; letter-spacing: 0.5px;">Cancellation &amp; Rescheduling Policy</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px; color: rgba(255,255,255,0.75); font-size: 0.85rem; line-height: 1.8;">

                <!-- ─── GOVERNING TEXT ─── -->
                <p style="margin-bottom: 16px; font-style: italic; color: rgba(255,255,255,0.4); font-size: 0.8rem;">
                    Governed by the laws of the Republic of South Africa
                </p>
                <p style="margin-bottom: 16px; color: rgba(255,255,255,0.6); font-size: 0.85rem;">
                    This Policy forms part of the Terms &amp; Conditions between RubiOr ("RubiOr", "the Platform"), the independent beauty artists who offer services through it ("Artists"), and clients who make bookings ("Clients"). By confirming a booking and paying a deposit, the Client accepts this Policy.
                </p>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 1: DEFINITIONS ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">1. Definitions</h6>
                <ul style="padding-left: 20px; margin-bottom: 16px; list-style-type: disc;">
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);"><strong style="color: #ffffff;">Booking Confirmed:</strong> The point at which an Artist accepts a Client's request and the Client pays the Deposit.</li>
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);"><strong style="color: #ffffff;">Deposit:</strong> The initial 50% payment required to secure a Booking.</li>
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);"><strong style="color: #ffffff;">Balance:</strong> The remaining 50% of the service price, due before the appointment as set out in Section 3.</li>
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);"><strong style="color: #ffffff;">Client Service Fee:</strong> The fee RubiOr charges the Client, in addition to the service price, at the time of booking.</li>
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);"><strong style="color: #ffffff;">Artist Service Fee:</strong> RubiOr's commission, calculated as a percentage of the service amount and deducted from the Artist's payout.</li>
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);"><strong style="color: #ffffff;">Cut-off Point:</strong> 48 hours (2 calendar days) before the scheduled appointment time.</li>
                </ul>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 2: BOOKING & DEPOSIT ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">2. Booking &amp; Deposit</h6>
                <ul style="padding-left: 20px; margin-bottom: 16px; list-style-type: disc;">
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);">A Booking is only secured once the Artist has accepted the request and the Client has paid the 50% Deposit.</li>
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);">The Deposit is calculated on the service price only. The Client Service Fee is charged separately at the time of booking (see Section 8).</li>
                </ul>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 3: BALANCE PAYMENT ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">3. Balance Payment</h6>
                <ul style="padding-left: 20px; margin-bottom: 16px; list-style-type: disc;">
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);">The remaining 50% Balance is due by the Cut-off Point (48 hours before the appointment).</li>
                    <li style="margin-bottom: 6px; color: rgba(255,255,255,0.6);">Failure to pay the Balance by the Cut-off Point may result in RubiOr treating the Booking as cancelled by the Client, subject to Section 5.</li>
                </ul>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 4: RESCHEDULING ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">4. Rescheduling</h6>
                <div style="background: rgba(255,215,0,0.04); border: 1px solid rgba(255,215,0,0.1); border-radius: 8px; padding: 12px 16px; margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(255,215,0,0.05);">
                        <span style="color: rgba(255,255,255,0.5);">More than 48 hours before the appointment</span>
                        <span style="color: rgba(255,255,255,0.7); font-weight: 700;">Yes — one reschedule to a new available date/time may be requested at no additional charge. The Deposit already paid carries over to the new date.</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 6px 0;">
                        <span style="color: rgba(255,255,255,0.5);">Within 48 hours of the appointment</span>
                        <span style="color: rgba(255,255,255,0.7); font-weight: 700;">No — once the Cut-off Point has passed, the appointment is locked and cannot be moved.</span>
                    </div>
                </div>
                <p style="margin-bottom: 16px; font-size: 0.8rem; color: rgba(255,255,255,0.4);">
                    Rescheduling is offered as a courtesy alternative to cancelling and forfeiting payment — it is not itself a right guaranteed by law, so RubiOr may set reasonable limits on it (e.g. one reschedule per booking, subject to Artist availability).
                </p>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 5: CANCELLATION BY CLIENT ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">5. Cancellation by the Client</h6>
                <p style="margin-bottom: 8px; color: rgba(255,255,255,0.6);">
                    A Client may cancel a Booking at any time — this is a right that cannot be removed. However, cancelling has the following financial consequences:
                </p>

                <p style="margin-bottom: 4px; font-weight: 700; color: #d4a843; font-size: 0.85rem;">a) Cancelling more than 48 hours before the appointment (before the Balance is paid):</p>
                <p style="margin-left: 20px; margin-bottom: 12px; color: rgba(255,255,255,0.6);">
                    The Deposit is forfeited and non-refundable. Nothing further is owed, since the Balance had not yet been collected. The Client may choose to reschedule instead (see Section 4) to preserve the value of the Deposit.
                </p>

                <p style="margin-bottom: 4px; font-weight: 700; color: #d4a843; font-size: 0.85rem;">b) Cancelling within 48 hours of the appointment, or after the Balance has been paid:</p>
                <p style="margin-left: 20px; margin-bottom: 12px; color: rgba(255,255,255,0.6);">
                    The full amount paid (Deposit + Balance) is forfeited and non-refundable. No rescheduling is available at this stage (see Section 4).
                </p>

                <p style="margin-bottom: 4px; font-weight: 700; color: #d4a843; font-size: 0.85rem;">c) No-shows:</p>
                <p style="margin-left: 20px; margin-bottom: 12px; color: rgba(255,255,255,0.6);">
                    A Client who does not arrive for a confirmed appointment, without prior cancellation, is treated as a same-day cancellation under 5(b) — full forfeiture applies.
                </p>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 6: MANDATORY EXCEPTION ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">6. Mandatory Exception — Death or Hospitalisation</h6>
                <p style="margin-bottom: 16px; color: rgba(255,255,255,0.6);">
                    In line with South African consumer protection law, no cancellation charge may be applied to the Deposit or Balance, and the Client is entitled to a full refund of the Deposit and Balance, where the Client — or the person for whom the appointment was booked — is unable to attend due to their death or hospitalisation. The Client Service Fee remains non-refundable in all cases, as set out in Section 8. RubiOr may reasonably request supporting documentation (e.g. a medical certificate or death certificate) before processing this refund.
                </p>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 7: CANCELLATION BY ARTIST ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">7. Cancellation by the Artist</h6>
                <p style="margin-bottom: 8px; color: rgba(255,255,255,0.6);">
                    If an Artist cancels a confirmed Booking, the Client will be offered, at their choice:
                </p>
                <ul style="padding-left: 20px; margin-bottom: 8px; list-style-type: disc;">
                    <li style="margin-bottom: 4px; color: rgba(255,255,255,0.6);">A full refund of the Deposit and Balance (if already paid), or</li>
                    <li style="margin-bottom: 4px; color: rgba(255,255,255,0.6);">A free reschedule to the next available slot, at no extra charge.</li>
                </ul>
                <p style="margin-bottom: 8px; color: rgba(255,255,255,0.6);">
                    The Client Service Fee is not refunded in this scenario — it remains non-refundable under all circumstances (see Section 8).
                </p>
                <p style="margin-bottom: 12px; color: rgba(255,255,255,0.6);">
                    On the Artist's side: the Artist Service Fee for that Booking is refunded to the Artist, since no service was delivered. However, RubiOr deducts a flat R10 cancellation penalty from the Artist's account whenever the Artist is the party who cancels a confirmed Booking.
                </p>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 8: SERVICE FEES ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">8. Service Fees</h6>

                <p style="font-weight: 700; color: #d4a843; margin-bottom: 4px; font-size: 0.85rem;">Client Service Fee</p>
                <p style="margin-left: 20px; margin-bottom: 12px; color: rgba(255,255,255,0.6);">
                    Charged to the Client at the time of booking, in addition to the service price. This fee is retained by RubiOr in full under all circumstances — cancellation by the Client, cancellation by the Artist, rescheduling, no-shows, or the death/hospitalisation exception in Section 6 — and is never refunded.
                </p>

                <p style="font-weight: 700; color: #d4a843; margin-bottom: 4px; font-size: 0.85rem;">Artist Service Fee</p>
                <p style="margin-left: 20px; margin-bottom: 12px; color: rgba(255,255,255,0.6);">
                    RubiOr's commission on a Booking, calculated as a percentage of the service amount and deducted from the Artist's payout. This fee is refunded to the Artist only where the Artist is the party who cancels a confirmed Booking.
                </p>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 9: LEGAL BASIS ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">9. Legal Basis</h6>
                <p style="margin-bottom: 8px; color: rgba(255,255,255,0.6);">
                    This Policy is designed to comply with the Consumer Protection Act 68 of 2008 (CPA), in particular Section 17, which:
                </p>
                <ul style="padding-left: 20px; margin-bottom: 8px; list-style-type: disc;">
                    <li style="margin-bottom: 4px; color: rgba(255,255,255,0.6);">Gives consumers the right to cancel an advance booking at any time;</li>
                    <li style="margin-bottom: 4px; color: rgba(255,255,255,0.6);">Allows suppliers to take a reasonable deposit and charge a reasonable cancellation fee, assessed against the nature of the service, the notice given, and the realistic ability to re-fill that time slot; and</li>
                    <li style="margin-bottom: 4px; color: rgba(255,255,255,0.6);">Prohibits any cancellation charge where the Client (or the person the booking was for) cannot attend due to death or hospitalisation.</li>
                </ul>
                <p style="margin-bottom: 12px; color: rgba(255,255,255,0.4); font-size: 0.8rem;">
                    Given that each Artist's appointment slot is a fixed, personal, time-bound service that is difficult to resell on short notice, full forfeiture of the Deposit (and, later, the full payment) closer to the appointment date is considered a reasonable cancellation charge under the CPA's criteria. The commission and penalty arrangements between RubiOr and its Artists in Sections 7 and 8 are a separate commercial arrangement, distinct from the consumer-facing terms above.
                </p>

                <hr style="border-color: rgba(255,215,0,0.1); margin: 20px 0;">

                <!-- ─── SECTION 10: QUERIES & DISPUTES ─── -->
                <h6 style="color: #d4a843; font-weight: 700; margin-bottom: 12px; font-size: 0.9rem;">10. Queries &amp; Disputes</h6>
                <p style="margin-bottom: 12px; color: rgba(255,255,255,0.6);">
                    Clients and Artists who wish to query or dispute a charge under this Policy can raise it directly through the Issues tab in the RubiOr app. Unresolved disputes may be referred to the National Consumer Commission (NCC).
                </p>

            </div>
            <div class="modal-footer" style="border-top: 1px solid rgba(255,215,0,0.1); padding: 16px 24px;">
                <button type="button" class="btn" data-bs-dismiss="modal" style="background: #d4a843; color: #0a0a0a; font-weight: 700; padding: 8px 28px; border-radius: 50px; border: none; font-size: 0.8rem; letter-spacing: 0.5px;">Close</button>
            </div>
        </div>
    </div>
</div>

@* ─── HOUSE CALL MODAL ─── *@
<div class="modal fade" id="houseCallModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="background: #0d0d0d; border: 2px solid rgba(255,215,0,0.3); border-radius: 20px;">
