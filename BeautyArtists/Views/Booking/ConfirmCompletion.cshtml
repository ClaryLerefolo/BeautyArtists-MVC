@model BeautyArtists.Models.ViewModels.ConfirmCompletionViewModel
@{
    ViewData["Title"] = "Confirm Appointment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 600px;">
    <div class="card" style="background: #0b0b0b; border: 1px solid rgba(255,215,0,0.2); border-radius: 16px; padding: 30px;">
        <h2 style="color: #FFD700; font-weight: 800; text-align: center; margin-bottom: 8px;">Confirm Your Appointment</h2>
        <p style="color: rgba(255,255,255,0.3); text-align: center; margin-bottom: 24px;">Please confirm whether your appointment was completed.</p>

        <div style="background: #1a1a1a; padding: 20px; border-radius: 10px; margin-bottom: 24px; border-left: 3px solid #FFD700;">
            <p style="margin: 4px 0;"><strong style="color: #FFD700;">Service:</strong> <span style="color: #fff;">@Model.ServiceName</span></p>
            <p style="margin: 4px 0;"><strong style="color: #FFD700;">Artist:</strong> <span style="color: #fff;">@Model.ArtistName</span></p>
            <p style="margin: 4px 0;"><strong style="color: #FFD700;">Date:</strong> <span style="color: #fff;">@Model.AppointmentDate.ToString("dddd, MMMM dd, yyyy")</span></p>
            <p style="margin: 4px 0;"><strong style="color: #FFD700;">Time:</strong> <span style="color: #fff;">@Model.AppointmentDate.ToString("hh:mm tt")</span></p>
        </div>

        <p style="color: rgba(255,255,255,0.5); font-size: 0.85rem; text-align: center; margin-bottom: 24px;">
            Please confirm if the artist completed your service. If you don't respond within <strong style="color: #FFD700;">5 hours</strong>, it will be automatically confirmed.
        </p>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <form asp-controller="Booking" asp-action="ConfirmCompletion" method="post" style="flex: 1;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.BookingId" />
                <input type="hidden" name="wasCompleted" value="true" />
                <button type="submit" style="width: 100%; padding: 14px; background: #28a745; color: #fff; font-weight: 700; font-size: 1rem; border: none; border-radius: 10px; cursor: pointer;">
                    Yes, Service Was Completed
                </button>
            </form>

            <form asp-controller="Booking" asp-action="ConfirmCompletion" method="post" style="flex: 1;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.BookingId" />
                <input type="hidden" name="wasCompleted" value="false" />
                <button type="submit" style="width: 100%; padding: 14px; background: #e50914; color: #fff; font-weight: 700; font-size: 1rem; border: none; border-radius: 10px; cursor: pointer;">
                    No, Service Was Not Completed
                </button>
            </form>
        </div>
    </div>
</div>