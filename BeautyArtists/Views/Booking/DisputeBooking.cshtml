@model BeautyArtists.Models.ViewModels.DisputeViewModel
@{
    ViewData["Title"] = "Dispute Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 600px;">
    <div class="card" style="background: #0b0b0b; border: 1px solid rgba(255,215,0,0.2); border-radius: 16px; padding: 30px;">
        <h2 style="color: #e50914; font-weight: 800; text-align: center; margin-bottom: 8px;">Dispute Booking</h2>
        <p style="color: rgba(255,255,255,0.3); text-align: center; margin-bottom: 24px;">Please provide details about why the service was not completed.</p>

        <div style="background: #1a1a1a; padding: 15px; border-radius: 10px; margin-bottom: 24px; border-left: 3px solid #e50914;">
            <p style="margin: 4px 0;"><strong style="color: #FFD700;">Service:</strong> <span style="color: #fff;">@Model.ServiceName</span></p>
            <p style="margin: 4px 0;"><strong style="color: #FFD700;">Booking #:</strong> <span style="color: #fff;">@Model.BookingId</span></p>
        </div>

        <form asp-controller="Booking" asp-action="DisputeBooking" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BookingId" />

            <div style="margin-bottom: 18px;">
                <label asp-for="Reason" style="color: rgba(255,255,255,0.5); font-size: 0.8rem; font-weight: 700; display: block; margin-bottom: 6px;">Reason for Dispute</label>
                <select asp-for="Reason" class="form-control" style="width: 100%; background: #1a1a1a; border: 1.5px solid rgba(255,215,0,0.2); border-radius: 10px; color: #fff; padding: 12px 16px;">
                    <option value="">-- Select a reason --</option>
                    <option value="no_show">Artist Did Not Show Up</option>
                    <option value="quality_issue">Quality of Service Was Poor</option>
                    <option value="other">Other Issue</option>
                </select>
                <span asp-validation-for="Reason" class="text-danger" style="color: #ff5555; font-size: 0.75rem;"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label asp-for="Description" style="color: rgba(255,255,255,0.5); font-size: 0.8rem; font-weight: 700; display: block; margin-bottom: 6px;">Tell us what happened</label>
                <textarea asp-for="Description" class="form-control" rows="5" style="width: 100%; background: #1a1a1a; border: 1.5px solid rgba(255,215,0,0.2); border-radius: 10px; color: #fff; padding: 12px 16px; resize: vertical;" placeholder="Please describe the issue in detail..."></textarea>
                <span asp-validation-for="Description" class="text-danger" style="color: #ff5555; font-size: 0.75rem;"></span>
            </div>

            <button type="submit" style="width: 100%; padding: 14px; background: #e50914; color: #fff; font-weight: 700; font-size: 1rem; border: none; border-radius: 10px; cursor: pointer;">
                Submit Dispute
            </button>
        </form>
    </div>
</div>