@model BeautyArtists.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Complete Final Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var artistPrice = Model.Booking.ServicePrice;
    var clientServicePrice = artistPrice * 1.15m;
    var depositAmount = (clientServicePrice / 2) + 5.00m;
    var finalAmount = clientServicePrice / 2;
    var clientTotal = clientServicePrice + 5.00m;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card" style="background: #0b0b0b; border: 1px solid rgba(40, 167, 69, 0.3);">
                <div class="card-header text-center" style="border-bottom-color: rgba(40,167,69,0.1);">
                    <h3 style="color: #28a745;">💵 Final Payment</h3>
                    <p style="color: #fff;">Booking #@Model.Booking.Id</p>
                    <p style="color: #28a745; font-size: 0.9rem;">
                        <i class="fas fa-check-circle me-1"></i> Deposit already paid
                    </p>
                </div>
                <div class="card-body">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                        </div>
                    }

                    <div class="booking-summary mb-4">
                        <h4 style="color: #28a745;">Booking Summary</h4>
                        <hr style="border-color: rgba(40,167,69,0.2);">
                        <p><strong>Service:</strong> @Model.Booking.UserService?.Service?.Name</p>
                        <p><strong>Artist:</strong> @Model.Booking.UserService?.Artist?.FirstName @Model.Booking.UserService?.Artist?.LastName</p>
                        <p><strong>Date:</strong> @Model.Booking.AppointmentDate.ToString("MMMM dd, yyyy")</p>
                        <p><strong>Time:</strong> @Model.Booking.AppointmentDate.ToString("hh:mm tt")</p>
                        <hr style="border-color: rgba(40,167,69,0.2);">

                        <div style="background: #1a1a1a; padding: 12px 15px; border-radius: 8px; margin: 10px 0;">
                            <p style="margin: 4px 0; display: flex; justify-content: space-between;">
                                <span style="color: rgba(255,255,255,0.6);">Service Price</span>
                                <span style="color: #fff;">R @clientServicePrice.ToString("N2")</span>
                            </p>
                            <p style="margin: 4px 0; display: flex; justify-content: space-between;">
                                <span style="color: rgba(255,255,255,0.6);">Booking Fee</span>
                                <span style="color: #FFD700;">R 5.00 <span style="color: #28a745; font-size: 0.7rem;">(Already Paid)</span></span>
                            </p>
                            <hr style="border-color: rgba(40,167,69,0.2); margin: 8px 0;">
                            <p style="margin: 4px 0; display: flex; justify-content: space-between;">
                                <span style="color: rgba(255,255,255,0.6);">Deposit Already Paid (50%)</span>
                                <span style="color: #ff6600;">R @depositAmount.ToString("N2")</span>
                            </p>
                            <p style="margin: 4px 0; display: flex; justify-content: space-between;">
                                <span style="color: rgba(255,255,255,0.6);">Remaining Balance (50%)</span>
                                <span style="color: #ff6600;">R @finalAmount.ToString("N2")</span>
                            </p>
                            <hr style="border-color: rgba(40,167,69,0.2); margin: 8px 0;">
                            <p style="margin: 6px 0 0 0; display: flex; justify-content: space-between; font-size: 1.2rem;">
                                <strong style="color: #fff;">Final Amount Due</strong>
                                <strong style="color: #28a745; font-size: 1.8rem; font-weight: 800;">R @finalAmount.ToString("N2")</strong>
                            </p>
                        </div>
                    </div>

                    <form method="post" asp-action="InitiateFinalPayment" asp-controller="Payment">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.Booking.Id" />
                        <input type="hidden" name="email" value="@Model.UserEmail" />
                        <input type="hidden" name="amount" value="@finalAmount" />

                        <button type="submit" class="btn w-100 py-3" style="background: linear-gradient(135deg, #28a745, #1a7a34); color: #fff; font-weight: 800; border-radius: 999px; border: none; transition: all 0.3s;">
                            💳 Pay Final – R @finalAmount.ToString("N2")
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <p style="color: rgba(255,255,255,0.2); font-size: 0.7rem;">
                            <i class="fas fa-lock me-1"></i> Secure payment via Paystack
                        </p>
                        <a asp-controller="Booking" asp-action="MyBookings" style="color: rgba(255,255,255,0.2); font-size: 0.8rem; text-decoration: none;">
                            ← Back to My Bookings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 30px rgba(40,167,69,0.3);
    }
</style>