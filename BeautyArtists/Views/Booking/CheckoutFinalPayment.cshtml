@model BeautyArtists.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Complete Final Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ─── ✅ FIXED: USE STORED VALUES FROM BOOKING ───
    var servicePrice = Model.Booking.ServicePrice;
    var cardFee = Model.Booking.CardProcessingFee;
    var bookingFee = Model.Booking.BookingFee;
    var totalAmount = Model.Booking.TotalAmount;

    // ─── ✅ FIXED: USE STORED DEPOSIT & FINAL VALUES ───
    var depositPaid = Model.Booking.DepositPaid;
    var finalAmount = Model.Booking.FinalAmount;
    var amountDue = finalAmount - Model.Booking.FinalPaymentPaid;

    // Prevent negative amount
    if (amountDue < 0) amountDue = 0;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card" style="background: #0b0b0b; border: 1px solid rgba(40, 167, 69, 0.3);">
                <div class="card-header text-center" style="border-bottom-color: rgba(40,167,69,0.1);">
                    <h3 style="color: #28a745;">💵 Final Payment</h3>
                    <p style="color: #fff;">Booking #@Model.Booking.Id</p>
                    <p style="color: #28a745; font-size: 0.9rem;">
                        <i class="fas fa-check-circle me-1"></i> Deposit already paid
                    </p>
                    @if (Model.IsNewClient)
                    {
                        <span class="client-tag new-client">⭐ New Client</span>
                    }
                    else
                    {
                        <span class="client-tag repeat-client">🔄 Repeat Client</span>
                    }
                </div>
                <div class="card-body">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                        </div>
                    }

                    <div class="booking-summary mb-4">
                        <h4 style="color: #28a745;">Booking Summary</h4>
                        <hr style="border-color: rgba(40,167,69,0.2);">
                        <p><strong>Service:</strong> @Model.Booking.UserService?.Service?.Name</p>
                        <p><strong>Artist:</strong> @Model.Booking.UserService?.Artist?.FirstName @Model.Booking.UserService?.Artist?.LastName</p>
                        <p><strong>Date:</strong> @Model.Booking.AppointmentDate.ToString("MMMM dd, yyyy")</p>
                        <p><strong>Time:</strong> @Model.Booking.AppointmentDate.ToString("hh:mm tt")</p>
                        <hr style="border-color: rgba(40,167,69,0.2);">

                        <!-- ─── PRICE BREAKDOWN ─── -->
                        <div style="background: #1a1a1a; padding: 12px 15px; border-radius: 8px; margin: 10px 0;">

                            <!-- Service Price -->
                            <p style="margin: 4px 0; display: flex; justify-content: space-between;">
                                <span style="color: rgba(255,255,255,0.6);">Service Price</span>
                                <span style="color: #fff;">R @servicePrice.ToString("N2")</span>
                            </p>

                            <!-- Card Processing Fee (4%) -->
                            <p style="margin: 4px 0; display: flex; justify-content: space-between;">
                                <span style="color: rgba(255,255,255,0.5);">Card Processing Fee (4%)</span>
                                <span style="color: #ff6600;">R @cardFee.ToString("N2")</span>
                            </p>

                            <!-- Booking Fee -->
                            <p style="margin: 4px 0; display: flex; justify-content: space-between;">
                                <span style="color: rgba(255,255,255,0.5);">Booking Fee</span>
                                <span style="color: #FFD700;">R @bookingFee.ToString("N2")</span>
                            </p>

                            <hr style="border-color: rgba(40,167,69,0.2); margin: 8px 0;">

                            <!-- Total Client Pays -->
                            <p style="margin: 4px 0; display: flex; justify-content: space-between; font-size: 1.2rem;">
                                <span style="color: #fff; font-weight: 600;">Total</span>
                                <span style="color: #FFD700; font-weight: 800;">R @totalAmount.ToString("N2")</span>
                            </p>

                            <hr style="border-color: rgba(40,167,69,0.2); margin: 8px 0;">

                            <!-- Deposit Already Paid -->
                            <p style="margin: 4px 0; display: flex; justify-content: space-between;">
                                <span style="color: rgba(255,255,255,0.6);">Deposit Already Paid</span>
                                <span style="color: #28a745; font-weight: 700;">R @depositPaid.ToString("N2")</span>
                            </p>

                            <!-- Remaining Balance -->
                            <p style="margin: 4px 0; display: flex; justify-content: space-between; font-size: 1.1rem;">
                                <span style="color: rgba(255,255,255,0.7); font-weight: 600;">Remaining Balance</span>
                                <span style="color: #ff6600; font-weight: 800;">R @amountDue.ToString("N2")</span>
                            </p>

                            <hr style="border-color: rgba(40,167,69,0.2); margin: 8px 0;">

                            <!-- Final Amount Due -->
                            <p style="margin: 6px 0 0 0; display: flex; justify-content: space-between; font-size: 1.2rem;">
                                <strong style="color: #fff;">Final Amount Due</strong>
                                <strong style="color: #28a745; font-size: 1.8rem; font-weight: 800;">R @amountDue.ToString("N2")</strong>
                            </p>
                        </div>

                        <!-- ─── PAYMENT BREAKDOWN ─── -->
                        <div style="background: rgba(40,167,69,0.04); padding: 10px 15px; border-radius: 8px; margin: 10px 0; border-left: 3px solid #28a745;">
                            <p style="margin: 4px 0; display: flex; justify-content: space-between; font-size: 0.9rem;">
                                <span style="color: rgba(255,255,255,0.5);">Deposit Paid</span>
                                <span style="color: #28a745; font-weight: 700;">R @depositPaid.ToString("N2")</span>
                            </p>
                            <p style="margin: 4px 0; display: flex; justify-content: space-between; font-size: 0.9rem;">
                                <span style="color: rgba(255,255,255,0.5);">Final Payment Due</span>
                                <span style="color: #ff6600; font-weight: 700;">R @amountDue.ToString("N2")</span>
                            </p>
                            <hr style="border-color: rgba(40,167,69,0.15); margin: 6px 0;">
                            <p style="margin: 4px 0; display: flex; justify-content: space-between; font-size: 1rem;">
                                <span style="color: rgba(255,255,255,0.6); font-weight: 600;">Total Paid</span>
                                <span style="color: #FFD700; font-weight: 800;">R @totalAmount.ToString("N2")</span>
                            </p>
                        </div>
                    </div>

                    <!-- ─── "I AGREE" CHECKBOX ─── -->
                    <div style="margin-top: 16px; padding: 14px 16px; background: rgba(40,167,69,0.04); border-radius: 10px; border-left: 3px solid #28a745;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="hasAgreedToTerms" name="hasAgreedToTerms" value="true" style="accent-color: #28a745; width: 18px; height: 18px; border: 2px solid rgba(40,167,69,0.3);" />
                            <label class="form-check-label" for="hasAgreedToTerms" style="color: rgba(255,255,255,0.7); font-size: 0.8rem; line-height: 1.4;">
                                By confirming this payment, you agree that your deposit and card processing fee are non-refundable should you wish to cancel your booking.
                            </label>
                        </div>
                        <div id="agreeError" class="text-danger small" style="display:none; margin-top: 8px;">
                            ⚠ You must agree to the terms before proceeding to payment.
                        </div>
                    </div>

                    <!-- ─── PAYMENT FORM ─── -->
                    <form method="post" asp-action="InitiateFinalPayment" asp-controller="Payment" id="paymentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.Booking.Id" />
                        <input type="hidden" name="email" value="@Model.UserEmail" />
                        <input type="hidden" name="amount" value="@amountDue" />
                        <input type="hidden" name="hasAgreedToTerms" id="hasAgreedToTermsHidden" value="false" />

                        <button type="submit" class="btn w-100 py-3 mt-3" style="background: linear-gradient(135deg, #28a745, #1a7a34); color: #fff; font-weight: 800; border-radius: 999px; border: none; transition: all 0.3s;" id="submitPaymentBtn">
                            💳 Pay Final – R @amountDue.ToString("N2")
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <p style="color: rgba(255,255,255,0.2); font-size: 0.7rem;">
                            <i class="fas fa-lock me-1"></i> Secure payment via Paystack
                        </p>
                        <a asp-controller="Booking" asp-action="MyBookings" style="color: rgba(255,255,255,0.2); font-size: 0.8rem; text-decoration: none;">
                            ← Back to My Bookings
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 30px rgba(40,167,69,0.3);
    }

    .client-tag {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        letter-spacing: 0.5px;
    }

        .client-tag.new-client {
            background: rgba(255,215,0,0.15);
            color: #FFD700;
            border: 1px solid rgba(255,215,0,0.3);
        }

        .client-tag.repeat-client {
            background: rgba(40,167,69,0.15);
            color: #28a745;
            border: 1px solid rgba(40,167,69,0.3);
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const paymentForm = document.getElementById('paymentForm');
        const agreeCheckbox = document.getElementById('hasAgreedToTerms');
        const agreeError = document.getElementById('agreeError');
        const agreeHidden = document.getElementById('hasAgreedToTermsHidden');

        if (paymentForm) {
            paymentForm.addEventListener('submit', function(e) {
                if (!agreeCheckbox.checked) {
                    e.preventDefault();
                    agreeError.style.display = 'block';
                    agreeError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return false;
                }
                agreeError.style.display = 'none';
                agreeHidden.value = 'true';
                return true;
            });
        }

        if (agreeCheckbox) {
            agreeCheckbox.addEventListener('change', function() {
                if (this.checked) {
                    agreeError.style.display = 'none';
                }
            });
        }
    });
</script>