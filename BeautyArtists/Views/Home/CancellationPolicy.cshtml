@{
    ViewData["Title"] = "Cancellation Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="card" style="background: #0b0b0b; border: 1px solid rgba(255,215,0,0.2); border-radius: 16px; padding: 30px;">
        <h1 style="color: #FFD700; font-weight: 800; font-size: 2rem; margin-bottom: 8px;">Cancellation Policy</h1>
        <p style="color: rgba(255,255,255,0.3); font-size: 0.85rem; margin-bottom: 30px;">Last updated: August 2026</p>

        <div style="color: rgba(255,255,255,0.7); font-size: 0.9rem; line-height: 1.8;">

            <div style="margin-bottom: 24px; padding: 16px 20px; background: rgba(255,215,0,0.04); border-left: 3px solid #FFD700; border-radius: 4px;">
                <h3 style="color: #FFD700; font-weight: 700; font-size: 1.1rem; margin: 0;">No Refund Policy</h3>
            </div>

            <p>By confirming a booking on RubiOr, you agree that <strong style="color: #ff6600;">all payments are non-refundable</strong> if you choose to cancel your appointment.</p>

            <hr style="border-color: rgba(255,215,0,0.1); margin: 24px 0;">

            <h3 style="color: #FFD700; font-weight: 700; font-size: 1rem; margin-bottom: 12px;">What This Means For You</h3>

            <ul style="padding-left: 20px; margin-bottom: 20px;">
                <li style="margin-bottom: 6px;"><strong style="color: #ff6600;">Deposit:</strong> Non-refundable</li>
                <li style="margin-bottom: 6px;"><strong style="color: #ff6600;">Card Processing Fee (4%):</strong> Non-refundable</li>
                <li style="margin-bottom: 6px;"><strong style="color: #ff6600;">Booking Fee:</strong> Non-refundable</li>
                <li style="margin-bottom: 6px;"><strong style="color: #ff6600;">Final Payment:</strong> Non-refundable</li>
            </ul>

            <p style="font-size: 0.85rem; color: rgba(255,255,255,0.4);">This policy protects the artist's time and the platform's processing costs.</p>

            <hr style="border-color: rgba(255,215,0,0.1); margin: 24px 0;">

            <h3 style="color: #FFD700; font-weight: 700; font-size: 1rem; margin-bottom: 12px;">Rescheduling Policy</h3>

            <ul style="padding-left: 20px; margin-bottom: 20px;">
                <li>Rescheduling is allowed up to <strong>24 hours before</strong> the appointment.</li>
                <li>Only <strong>one reschedule</strong> is permitted per booking.</li>
            </ul>

            <hr style="border-color: rgba(255,215,0,0.1); margin: 24px 0;">

            <h3 style="color: #FFD700; font-weight: 700; font-size: 1rem; margin-bottom: 12px;">Artist Cancellations</h3>

            <ul style="padding-left: 20px; margin-bottom: 20px;">
                <li>If the artist cancels, you receive a <strong style="color: #28a745;">full refund</strong> (including all fees).</li>
                <li>No-shows or late arrivals: No refund.</li>
            </ul>

            <hr style="border-color: rgba(255,215,0,0.1); margin: 24px 0;">

            <h3 style="color: #FFD700; font-weight: 700; font-size: 1rem; margin-bottom: 12px;">Need Help?</h3>

            <p>Contact us at <a href="mailto:support@rubior.com" style="color: #FFD700; text-decoration: none;">support@rubior.com</a></p>

            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(255,215,0,0.1);">
                <a href="javascript:history.back()" style="color: rgba(255,255,255,0.3); text-decoration: none; font-size: 0.85rem;">
                    ← Back
                </a>
            </div>
        </div>
    </div>
</div>