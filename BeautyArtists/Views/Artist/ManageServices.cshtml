@using System.Text.Encodings.Web
@model IEnumerable<BeautyArtists.Models.UserService>
@{
    ViewData["Title"] = "Artist Service Menu";
    Layout = "~/Views/Shared/_ArtistLayout.cshtml";
}

@section Styles {
    <style>
        body {
            background: #000;
            color: #f0f0f0;
            font-family: 'Segoe UI', sans-serif;
        }

        .dashboard-header {
            background: linear-gradient(90deg, #e50914, #f0c808);
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            margin-bottom: 25px;
        }

            .dashboard-header h2 {
                color: #000;
                font-weight: 800;
                text-transform: uppercase;
                margin: 0;
            }

        .service-card {
            background-color: #121212;
            border: 1px solid rgba(240, 200, 8, 0.2);
            border-radius: 15px;
            transition: 0.3s ease;
        }

            .service-card:hover {
                transform: translateY(-5px);
                border-color: #f0c808;
            }

        .modal-content {
            background: #0a0a0a;
            border: 2px solid #f0c808;
            border-radius: 20px;
        }

        .form-control, .form-select {
            background-color: #1a1a1a;
            border: 1px solid #333;
            color: white;
        }

            .form-control:focus, .form-select:focus {
                background-color: #222;
                border-color: #f0c808;
                color: white;
                box-shadow: 0 0 0 0.25rem rgba(240, 200, 8, 0.25);
            }

        .input-label {
            color: #f0c808;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }

        .badge-active {
            background: #28a745;
            color: #fff;
        }

        .badge-inactive {
            background: #6c757d;
            color: #fff;
        }

        .service-card .card-img-top {
            height: 200px;
            object-fit: cover;
        }

        .price-breakdown {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.3);
            display: block;
            margin-top: 2px;
        }

            .price-breakdown span {
                color: #FFD700;
            }

        .client-pays-display {
            margin-top: 8px;
            padding: 8px 12px;
            background: rgba(255, 215, 0, 0.06);
            border-radius: 6px;
            border-left: 2px solid #FFD700;
        }

            .client-pays-display .label {
                color: rgba(255, 255, 255, 0.5);
                font-size: 0.75rem;
            }

            .client-pays-display .value {
                color: #FFD700;
                font-weight: 700;
                font-size: 0.9rem;
            }

        .disclaimer-box {
            padding: 12px 14px;
            background: rgba(255, 215, 0, 0.05);
            border-radius: 8px;
            border-left: 3px solid #FFD700;
        }

            .disclaimer-box .form-check-input {
                accent-color: #FFD700;
                width: 18px;
                height: 18px;
                border: 2px solid rgba(255, 215, 0, 0.3);
            }

            .disclaimer-box .form-check-label {
                color: rgba(255, 255, 255, 0.7);
                font-size: 0.75rem;
                line-height: 1.4;
            }

            .disclaimer-box .highlight-gold {
                color: #FFD700;
            }

            .disclaimer-box .text-danger {
                display: none;
                margin-top: 6px;
            }

        .artist-receives {
            margin-top: 6px;
            padding: 6px 10px;
            background: rgba(40, 167, 69, 0.06);
            border-radius: 6px;
            border-left: 2px solid #28a745;
            font-size: 0.65rem;
            color: rgba(255,255,255,0.5);
        }

            .artist-receives .amount {
                color: #28a745;
                font-weight: 700;
            }
    </style>
}

<div class="dashboard-header">
    <h2><i class="fas fa-cut"></i> Artist Service Menu</h2>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 px-4" style="gap: 12px;">
    <h4 class="text-white mb-0">Active Services: <span style="color: #f0c808;">@Model.Count(s => s.IsActive)</span></h4>
    <button class="btn rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#addServiceModal"
            style="background: linear-gradient(45deg, #f0c808, #e50914); color: #000; font-weight: 700; border: none; white-space: nowrap;">
        <i class="fas fa-plus-circle me-2"></i>+ ADD SERVICE
    </button>
</div>

@* ─── SERVICE CARDS ─── *@
<div class="row pt-2 px-4" id="serviceOfferingRow">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4" id="service-row-@item.Id">
            <div class="card h-100 service-card text-white overflow-hidden">
                <img src="@(string.IsNullOrEmpty(item.ImagePath) ? (item.Service?.ImagePath ?? "/images/default-service.jpg") : item.ImagePath)"
                     class="card-img-top" alt="@item.Service?.Name">
                <div class="card-body p-4">
                    <h3 style="color: #f0c808; font-weight: 700;">@item.Service?.Name</h3>
                    <p class="text-muted small">@item.CustomDescription</p>
                    <div class="p-3 rounded mb-3" style="background: #1a1a1a;">
                        <div class="small mb-1"><span style="color:#f0c808">Category:</span> @(item.Service?.ServiceCategory?.Name ?? "General")</div>
                        <div class="small mb-1"><span style="color:#f0c808">Duration:</span> @item.Duration min</div>
                        <div class="mt-2 pt-2 border-top" style="border-color:rgba(255,215,0,0.1);">

                            <!-- ─── YOUR PRICE ─── -->
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span style="color:#f0c808; font-weight:600;">Your Price:</span>
                                <span style="color:#fff; font-weight:800;">R @item.Price.ToString("N2")</span>
                            </div>

                            <!-- ─── CLIENT PAYS ─── -->
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px;">
                                <span style="color:rgba(255,215,0,0.4); font-size:0.7rem;">Client pays:</span>
                                <span style="color:#FFD700; font-weight:600; font-size:0.85rem;">R @((item.Price * 1.04m).ToString("N2"))</span>
                            </div>

                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("ArtistServiceDetail", "Artist", new { id = item.Id })" class="btn btn-warning w-100 fw-bold">View Service</a>
                        <button class="btn btn-outline-danger w-100 fw-bold delete-service" data-id="@item.Id">
                            <i class="fas fa-trash-alt"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ─── ADD SERVICE MODAL ─── *@
<div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title font-weight-bold" style="color: #f0c808;">ADD NEW SERVICE</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Artist" asp-action="AddService" method="post" enctype="multipart/form-data" id="addServiceForm">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label class="input-label">Select Service Template</label>
                            <select name="ServiceId" id="baseServiceSelect" class="form-select" required>
                                <option value="">-- Choose a Service --</option>
                                @foreach (var svc in (IEnumerable<SelectListItem>)ViewBag.AvailableServices)
                                {
                                    <option value="@svc.Value">@svc.Text</option>
                                }
                            </select>
                        </div>

                        <div id="adminDetailsSection" style="display:none; margin-bottom: 20px; width: 100%;">
                            <div style="background: rgba(229, 9, 20, 0.1); border-left: 4px solid #e50914; padding: 15px; border-radius: 4px;">
                                <div class="row">
                                    <div class="col-md-4"><small class="text-muted d-block">Admin Category</small><strong id="adminCategory" style="color: #f0c808;"></strong></div>
                                    <div class="col-md-4"><small class="text-muted d-block">Base Price</small><strong id="adminBasePrice" style="color: #f0c808;"></strong></div>
                                    <div class="col-md-4"><small class="text-muted d-block">Standard Duration</small><strong id="adminBaseDuration" style="color: #f0c808;"></strong></div>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted d-block">Admin Description:</small>
                                    <p id="adminBaseDescription" class="small mb-0" style="font-style: italic;"></p>
                                </div>
                            </div>
                        </div>

                        <!-- ─── PRICE & DURATION SIDE BY SIDE ─── -->
                        <div class="col-md-6">
                            <label class="input-label">Your Price (R)</label>
                            <input type="number" name="Price" id="add_Price" class="form-control" step="0.01" required oninput="updateClientTotal('add')" />
                        </div>
                        <div class="col-md-6">
                            <label class="input-label">Your Duration (Mins)</label>
                            <input type="number" name="Duration" id="add_Duration" class="form-control" required />
                        </div>

                   

                        <div class="col-12">
                            <label class="input-label">Service Photo (Optional)</label>
                            <input type="file" name="ImageFile" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="input-label">Custom Description</label>
                            <textarea name="CustomDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked>
                                <label class="form-check-label text-white ms-2">Make Service Active Immediately</label>
                            </div>
                        </div>

                        <!-- ─── CLIENT PAYS DISPLAY ─── -->
                        <div class="col-12">
                            <div class="client-pays-display">
                                <span class="label">Client Pays:</span>
                                <span class="value" id="addClientTotal">R 0.00</span>
                            </div>
                        </div>
                        <!-- ─── "Got It" Acknowledgment ─── -->
                        <div class="col-12">
                            <div class="disclaimer-box">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="addAgreeToTerms" value="true" />
                                    <label class="form-check-label" for="addAgreeToTerms">
                                        The card processing fee is calculated as 4% of your price plus a flat R5, and is charged separately to the client — it is never deducted from your payout.
                                        You further acknowledge that RubiOr charges a <span class="highlight-gold">10% commission</span> (no cap) on a new client's first booking with you,
                                        and a flat <span class="highlight-gold">R15</span> fee on each booking thereafter with that same client.
                                    </label>
                                </div>
                                <div id="addAgreeError" class="text-danger">⚠ You must acknowledge the terms before adding a service.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4">
                    <button type="submit" class="btn w-100 py-3 font-weight-bold" style="background: #f0c808; color: #000;">+ ADD TO MENU</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ─── EDIT SERVICE MODAL ─── *@
<div class="modal fade" id="editServiceModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title font-weight-bold" style="color: #f0c808;">EDIT YOUR SERVICE</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Artist" asp-action="EditUserService" method="post" enctype="multipart/form-data" id="editServiceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="edit_Id" />

                <div class="modal-body px-4">
                    <div class="row g-4">
                        <!-- ─── PRICE & DURATION SIDE BY SIDE ─── -->
                        <div class="col-md-6">
                            <label class="input-label">Your Price (R)</label>
                            <input type="number" name="Price" id="edit_Price" class="form-control" step="0.01" required oninput="updateClientTotal('edit')" />
                        </div>
                        <div class="col-md-6">
                            <label class="input-label">Your Duration (Mins)</label>
                            <input type="number" name="Duration" id="edit_Duration" class="form-control" required />
                        </div>

                        <!-- ─── CLIENT PAYS DISPLAY ─── -->
                        <div class="col-12">
                            <div class="client-pays-display">
                                <span class="label">Client Pays:</span>
                                <span class="value" id="editClientTotal">R 0.00</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="input-label">Change Photo (Optional)</label>
                            <input type="file" name="ImageFile" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="input-label">Custom Description</label>
                            <textarea name="CustomDescription" id="edit_Description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="edit_IsActive" value="true">
                                <label class="form-check-label text-white ms-2">Active</label>
                            </div>
                        </div>

                        <!-- ─── "Got It" Acknowledgment ─── -->
                        <div class="col-12">
                            <div class="disclaimer-box">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="editAgreeToTerms" value="true" />
                                    <label class="form-check-label" for="editAgreeToTerms">
                                        The card processing fee is calculated as 4% of your price plus a flat R5, and is charged separately to the client — it is never deducted from your payout.
                                        You further acknowledge that RubiOr charges a <span class="highlight-gold">10% commission</span> (no cap) on a new client's first booking with you,
                                        and a flat <span class="highlight-gold">R15</span> fee on each booking thereafter with that same client.
                                    </label>
                                </div>
                                <div id="editAgreeError" class="text-danger">⚠ You must acknowledge the terms before updating a service.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4">
                    <button type="submit" class="btn w-100 py-3 font-weight-bold" style="background: #f0c808; color: #000;">UPDATE SERVICE</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const rawServices = @Html.Raw(Json.Serialize(ViewBag.RawServices));

        function updateClientTotal(type) {
            const priceInput = document.getElementById(type === 'add' ? 'add_Price' : 'edit_Price');
            const totalDisplay = document.getElementById(type === 'add' ? 'addClientTotal' : 'editClientTotal');

            if (priceInput && totalDisplay) {
                const price = parseFloat(priceInput.value) || 0;
                const clientTotal = price + (price * 0.04) + 5;
                totalDisplay.textContent = 'R ' + clientTotal.toFixed(2);
            }
        }

        document.getElementById('baseServiceSelect').addEventListener('change', function() {
            const s = rawServices.find(x => (x.id || x.Id) == this.value);
            if (s) {
                const category = s.serviceCategory || s.ServiceCategory;
                $('#adminCategory').text(category ? (category.name || category.Name) : "N/A");
                $('#adminBasePrice').text('R ' + parseFloat(s.basePrice || s.BasePrice).toFixed(2));
                $('#adminBaseDuration').text((s.duration || s.Duration) + ' Mins');
                $('#adminBaseDescription').text(s.description || s.Description);
                $('#adminDetailsSection').fadeIn();
                document.getElementById('add_Price').value = s.basePrice || s.BasePrice;
                document.getElementById('add_Duration').value = s.duration || s.Duration;
                setTimeout(function() { updateClientTotal('add'); }, 50);
            } else {
                $('#adminDetailsSection').fadeOut();
            }
        });

        document.getElementById('addServiceForm').addEventListener('submit', function(e) {
            const agreeCheckbox = document.getElementById('addAgreeToTerms');
            const agreeError = document.getElementById('addAgreeError');
            if (!agreeCheckbox.checked) {
                e.preventDefault();
                agreeError.style.display = 'block';
                agreeError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }
            agreeError.style.display = 'none';
            return true;
        });

        document.getElementById('editServiceForm').addEventListener('submit', function(e) {
            const agreeCheckbox = document.getElementById('editAgreeToTerms');
            const agreeError = document.getElementById('editAgreeError');
            if (!agreeCheckbox.checked) {
                e.preventDefault();
                agreeError.style.display = 'block';
                agreeError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }
            agreeError.style.display = 'none';
            return true;
        });

        document.getElementById('addAgreeToTerms').addEventListener('change', function() {
            document.getElementById('addAgreeError').style.display = 'none';
        });
        document.getElementById('editAgreeToTerms').addEventListener('change', function() {
            document.getElementById('editAgreeError').style.display = 'none';
        });

        function openEditModal(id, price, duration, desc, isActive) {
            document.getElementById('edit_Id').value = id;
            document.getElementById('edit_Price').value = price;
            document.getElementById('edit_Duration').value = duration;
            document.getElementById('edit_Description').value = desc;
            document.getElementById('edit_IsActive').checked = (isActive === true || isActive === "true");

            setTimeout(function() {
                updateClientTotal('edit');
            }, 50);

            document.getElementById('editAgreeToTerms').checked = false;
            document.getElementById('editAgreeError').style.display = 'none';

            var myModal = new bootstrap.Modal(document.getElementById('editServiceModal'));
            myModal.show();
        }

        $(document).on('click', '.delete-service', function() {
            const id = $(this).data('id');
            const card = $(`#service-row-${id}`);
            Swal.fire({
                title: 'Remove Service?',
                text: "This will remove it from your menu.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e50914',
                confirmButtonText: 'Yes, remove it',
                background: '#0a0a0a',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Artist/DeleteUserService/' + id, {
                        "__RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    }, function() {
                        card.fadeOut(500);
                        Swal.fire('Removed!', '', 'success');
                    });
                }
            });
        });
    </script>
}