@model BeautyArtists.Models.ViewModels.UserServiceViewModel

@{
    ViewData["Title"] = "Add Service";
    Layout = "~/Views/Shared/_ArtistLayout.cshtml";
}

<style>
    body {
        background: #000;
        color: #f0f0f0;
        font-family: 'Segoe UI', sans-serif;
    }

    .form-container {
        max-width: 700px;
        margin: 40px auto;
        background: #121212;
        border: 1px solid rgba(240, 200, 8, 0.2);
        border-radius: 15px;
        padding: 35px;
    }

    .form-title {
        color: #FFD700;
        font-weight: 800;
        font-size: 1.8rem;
        margin-bottom: 25px;
        border-bottom: 2px solid rgba(255, 215, 0, 0.15);
        padding-bottom: 15px;
    }

    .form-label {
        color: #FFD700;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 5px;
    }

    .form-control, .form-select {
        background-color: #1a1a1a !important;
        border: 1px solid #333 !important;
        color: #fff !important;
        border-radius: 8px !important;
        padding: 10px 14px !important;
    }

        .form-control:focus, .form-select:focus {
            border-color: #FFD700 !important;
            box-shadow: 0 0 0 0.25rem rgba(255, 215, 0, 0.15) !important;
            background-color: #222 !important;
        }

    .form-text {
        color: rgba(255, 255, 255, 0.3) !important;
        font-size: 0.75rem !important;
        margin-top: 4px !important;
    }

    .price-highlight {
        background: rgba(255, 215, 0, 0.05);
        border-left: 3px solid #FFD700;
        padding: 12px 16px;
        border-radius: 6px;
        margin: 10px 0 15px 0;
    }

    .price-highlight-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2px 0;
    }

    .price-highlight-label {
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.8rem;
    }

    .price-highlight-value {
        color: #fff;
        font-weight: 600;
    }

    .price-highlight-value-gold {
        color: #FFD700;
        font-weight: 700;
    }

    .price-highlight-value-orange {
        color: #ff6600;
        font-weight: 600;
    }

    .btn-gold {
        background: linear-gradient(180deg, #FFD700 0%, #FF8C00 100%);
        color: #000 !important;
        font-weight: 700;
        padding: 10px 30px;
        border-radius: 30px;
        border: none;
        transition: 0.3s;
        width: 100%;
        font-size: 1rem;
    }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(255, 140, 0, 0.4);
            color: #000 !important;
        }

    .text-danger {
        color: #e50914 !important;
        font-size: 0.8rem;
    }

    .form-check-input {
        background-color: #1a1a1a !important;
        border-color: #333 !important;
    }

        .form-check-input:checked {
            background-color: #FFD700 !important;
            border-color: #FFD700 !important;
        }

    .form-check-label {
        color: rgba(255, 255, 255, 0.7);
    }
</style>

<div class="form-container">
    <h2 class="form-title"><i class="fas fa-plus-circle me-2"></i>Add a Service</h2>

    <form asp-action="AddService" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Category</label>
            <select id="categoryDropdown" class="form-select">
                <option value="">-- Select Category --</option>
                @foreach (var category in ViewBag.Categories as List<SelectListItem>)
                {
                    <option value="@category.Value">@category.Text</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ServiceId" class="form-label">Service</label>
            <select asp-for="ServiceId" class="form-select" id="serviceDropdown">
                <option value="">-- Select Service --</option>
                @* JS will populate this *@
            </select>
            <span asp-validation-for="ServiceId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Your Price (R) – <span style="color:#fff; font-weight:400;">What you earn</span></label>
            <input asp-for="Price" class="form-control" step="0.01" required />
            <span asp-validation-for="Price" class="text-danger"></span>

            <!-- ✅ FIXED: 4% pricing breakdown -->
            <div class="price-highlight" id="priceBreakdown" style="display:none;">
                <div class="price-highlight-item">
                    <span class="price-highlight-label">Your Price:</span>
                    <span class="price-highlight-value" id="artistPriceDisplay">R 0.00</span>
                </div>
                <div class="price-highlight-item">
                    <span class="price-highlight-label">Platform Fee (4%):</span>
                    <span class="price-highlight-value-orange" id="platformFeeDisplay">R 0.00</span>
                </div>
                <div class="price-highlight-item" style="border-top:1px solid rgba(255,215,0,0.1); padding-top:4px; margin-top:4px;">
                    <span class="price-highlight-label" style="color:rgba(255,215,0,0.4);">Client pays:</span>
                    <span class="price-highlight-value-gold" id="clientPriceDisplay">R 0.00</span>
                </div>
                <small style="display:block; margin-top:4px; color:rgba(255,255,255,0.2); font-size:0.6rem; text-align:right;">
                    <i class="fas fa-info-circle"></i> 4% platform fee added. You receive 100% of your price.
                </small>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CustomDescription" class="form-label">Custom Description</label>
            <textarea asp-for="CustomDescription" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label for="Images" class="form-label">Service Photo (Optional)</label>
            <input type="file" name="ImageFile" class="form-control" accept="image/*" />
            <div class="form-text">Upload a photo to showcase your service.</div>
        </div>

        <div class="mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked>
                <label class="form-check-label">Make Service Active Immediately</label>
            </div>
        </div>

        <button type="submit" class="btn-gold"><i class="fas fa-plus-circle me-2"></i>Add Service</button>
    </form>

    <div class="mt-3 text-center">
        <a href="@Url.Action("ManageServices", "Artist")" class="back-link" style="color:rgba(255,215,0,0.4); text-decoration:none; font-size:0.8rem;">
            ← Back to My Services
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ── Category dropdown → load services ──
        document.getElementById('categoryDropdown').addEventListener('change', function () {
            var categoryId = this.value;
            var serviceDropdown = document.getElementById('serviceDropdown');
            serviceDropdown.innerHTML = '<option value="">Loading...</option>';

            fetch(`/Artist/GetServicesByCategory/${categoryId}`)
                .then(response => response.json())
                .then(data => {
                    serviceDropdown.innerHTML = '<option value="">-- Select Service --</option>';
                    data.forEach(function (service) {
                        var option = document.createElement('option');
                        option.value = service.value;
                        option.text = service.text;
                        serviceDropdown.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('Error loading services:', error);
                    serviceDropdown.innerHTML = '<option value="">-- Error loading services --</option>';
                });
        });

        // ── Price input → show real-time breakdown ──
        document.getElementById('Price').addEventListener('input', function () {
            var price = parseFloat(this.value);
            var breakdown = document.getElementById('priceBreakdown');

            if (isNaN(price) || price <= 0) {
                breakdown.style.display = 'none';
                return;
            }

            var platformFee = price * 0.04;  // 4% markup
            var clientPrice = price + platformFee;

            document.getElementById('artistPriceDisplay').textContent = 'R ' + price.toFixed(2);
            document.getElementById('platformFeeDisplay').textContent = 'R ' + platformFee.toFixed(2);
            document.getElementById('clientPriceDisplay').textContent = 'R ' + clientPrice.toFixed(2);

            breakdown.style.display = 'block';
        });

        // ── Trigger price breakdown on load if price has value ──
        document.addEventListener('DOMContentLoaded', function () {
            var priceInput = document.getElementById('Price');
            if (priceInput.value && parseFloat(priceInput.value) > 0) {
                var event = new Event('input');
                priceInput.dispatchEvent(event);
            }
        });
    </script>
}