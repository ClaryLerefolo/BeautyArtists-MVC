@model IEnumerable<BeautyArtists.Models.HeroBanner>
@{
    ViewData["Title"] = "Manage Hero Banners";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var bannerList = Model.ToList();

    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var showingFrom = ViewBag.ShowingFrom as int? ?? 0;
    var showingTo = ViewBag.ShowingTo as int? ?? 0;
}

@section Styles {
    <style>
        .mb-eyebrow {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,215,0,0.35);
            display: block;
            margin-bottom: 4px;
        }

        .mb-heading {
            font-size: 1.5rem;
            font-weight: 900;
            color: #FFD700;
            margin: 0 0 24px;
        }

        /* ── TOP BAR ── */
        .mb-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .mb-count {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 3px 12px;
            border: 1px solid rgba(255,255,255,0.07);
        }

        .mb-add-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: 999px;
            background: linear-gradient(135deg, #b30000, #FFD700);
            color: #000;
            font-weight: 800;
            font-size: 0.78rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.2s;
        }

            .mb-add-btn:hover {
                background: linear-gradient(135deg, #FFD700, #b30000);
                color: #000;
                box-shadow: 0 0 20px rgba(255,215,0,0.3);
                transform: translateY(-2px);
            }

        /* ── GRID ── */
        .mb-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        /* ── CARD ── */
        .mb-card {
            background: #0b0b0b;
            border: 1px solid rgba(255,215,0,0.12);
            border-radius: 16px;
            overflow: hidden;
            transition: border-color 0.25s, transform 0.25s;
            display: flex;
            flex-direction: column;
        }

            .mb-card:hover {
                border-color: rgba(255,215,0,0.3);
                transform: translateY(-4px);
                box-shadow: 0 16px 40px rgba(0,0,0,0.5);
            }

        .mb-card-img-wrap {
            position: relative;
            height: 180px;
            overflow: hidden;
            background: #050505;
        }

        .mb-card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .mb-card:hover .mb-card-img {
            transform: scale(1.05);
        }

        .mb-card-img-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.85) 100%);
        }

        /* Title on image */
        .mb-card-title {
            position: absolute;
            left: 16px;
            right: 16px;
            bottom: 12px;
            font-size: 0.95rem;
            font-weight: 800;
            color: #FFD700;
            text-shadow: 0 2px 8px rgba(0,0,0,0.9);
            letter-spacing: 0.3px;
            line-height: 1.3;
            z-index: 2;
        }

        /* ── CARD BODY ── */
        .mb-card-body {
            padding: 16px 18px 18px;
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: 12px;
        }

        .mb-card-subtitle {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.45);
            line-height: 1.5;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .mb-actions {
            display: flex;
            gap: 8px;
            margin-top: auto;
        }

        .mb-btn-edit {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 12px;
            border-radius: 8px;
            background: rgba(255,215,0,0.1);
            border: 1px solid rgba(255,215,0,0.2);
            color: #FFD700;
            font-weight: 700;
            font-size: 0.75rem;
            text-decoration: none;
            transition: all 0.2s;
        }

            .mb-btn-edit:hover {
                background: rgba(255,215,0,0.2);
                border-color: rgba(255,215,0,0.4);
                color: #FFD700;
            }

        .mb-btn-delete {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 12px;
            border-radius: 8px;
            background: rgba(179,0,0,0.12);
            border: 1px solid rgba(179,0,0,0.25);
            color: #ff6666;
            font-weight: 700;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s;
        }

            .mb-btn-delete:hover {
                background: rgba(179,0,0,0.25);
                border-color: rgba(179,0,0,0.5);
                color: #ff8888;
            }

        /* ── EMPTY ── */
        .mb-empty {
            grid-column: 1 / -1;
            padding: 64px 20px;
            text-align: center;
            background: #0b0b0b;
            border: 1px solid rgba(255,215,0,0.08);
            border-radius: 16px;
        }

        /* ── PAGINATION ── */
        .mb-pager {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            padding: 16px 20px;
            background: #0b0b0b;
            border: 1px solid rgba(255,215,0,0.1);
            border-radius: 14px;
        }

        .mb-pager-info {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.35);
        }

            .mb-pager-info strong {
                color: #FFD700;
                font-weight: 700;
            }

        .mb-pager-controls {
            display: flex;
            gap: 4px;
            align-items: center;
            flex-wrap: wrap;
        }

        .mb-page-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
            padding: 0 10px;
            border-radius: 7px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,215,0,0.1);
            color: rgba(255,255,255,0.6);
            font-size: 0.78rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s;
        }

            .mb-page-btn:hover {
                background: rgba(255,215,0,0.1);
                color: #FFD700;
                border-color: rgba(255,215,0,0.3);
            }

            .mb-page-btn.active {
                background: #FFD700;
                color: #000;
                border-color: #FFD700;
                box-shadow: 0 0 12px rgba(255,215,0,0.25);
            }

            .mb-page-btn.disabled {
                opacity: 0.3;
                pointer-events: none;
                cursor: not-allowed;
            }

        .mb-page-ellipsis {
            padding: 0 6px;
            color: rgba(255,255,255,0.25);
            font-size: 0.8rem;
        }

        /* ══════════════════════════════════
                   MOBILE (<= 600px)
                   ══════════════════════════════════ */
        @@media (max-width: 600px) {
            .mb-heading {
                font-size: 1.25rem;
                margin-bottom: 18px;
            }

            .mb-topbar {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }

            .mb-add-btn {
                justify-content: center;
                width: 100%;
            }

            .mb-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }

            .mb-card-img-wrap {
                height: 160px;
            }

            .mb-card-body {
                padding: 14px;
            }
            /* Stack action buttons vertically */
            .mb-actions {
                flex-direction: column;
                gap: 8px;
            }

            .mb-btn-edit,
            .mb-btn-delete {
                width: 100%;
                padding: 10px;
                font-size: 0.78rem;
            }

            .mb-actions form {
                margin: 0 !important;
                width: 100%;
            }

            .mb-pager {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
                padding: 14px;
            }

            .mb-pager-info {
                text-align: center;
            }

            .mb-pager-controls {
                justify-content: center;
            }
        }
    </style>
}

<span class="mb-eyebrow">Marketing</span>
<h1 class="mb-heading">Hero Banners</h1>

<div class="mb-topbar">
    <span class="mb-count">
        @totalCount active banner@(totalCount != 1 ? "s" : "")
    </span>
    <a asp-action="CreateHeroBanner" asp-controller="Admin" class="mb-add-btn">
        <i class="bi bi-plus-lg"></i> Add Banner
    </a>
</div>

<div class="mb-grid">
    @if (!bannerList.Any())
    {
        <div class="mb-empty">
            <i class="bi bi-image" style="font-size: 2.5rem; color: rgba(255,215,0,0.15); display: block; margin-bottom:10px;"></i>
            <p style="color: rgba(255,255,255,0.25); margin: 0;">No banners active. Add one to spice up the homepage.</p>
        </div>
    }
    else
    {
        foreach (var banner in bannerList)
        {
            <div class="mb-card">
                <div class="mb-card-img-wrap">
                    <img src="@banner.ImagePath" alt="Hero Banner" class="mb-card-img" />
                    <div class="mb-card-img-overlay"></div>

                    @if (!string.IsNullOrEmpty(banner.Title))
                    {
                        <div class="mb-card-title">@banner.Title</div>
                    }
                </div>

                <div class="mb-card-body">
                    @if (!string.IsNullOrEmpty(banner.Subtitle))
                    {
                        <p class="mb-card-subtitle">@banner.Subtitle</p>
                    }

                    <div class="mb-actions">
                        <a asp-action="EditHeroBanner" asp-controller="Admin" asp-route-id="@banner.Id"
                           class="mb-btn-edit">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>

                        <form asp-action="DeleteHeroBanner" asp-controller="Admin" method="post"
                              onsubmit="return confirm('Delete this banner?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@banner.Id" />
                            <button type="submit" class="mb-btn-delete">
                                <i class="bi bi-trash3-fill"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

@* ── PAGINATION ── *@
@if (totalPages > 1)
{
    <div class="mb-pager">
        <div class="mb-pager-info">
            Showing <strong>@showingFrom</strong> – <strong>@showingTo</strong> of <strong>@totalCount</strong>
        </div>
        <div class="mb-pager-controls">
            @{
                var prevDisabled = currentPage <= 1;
                var nextDisabled = currentPage >= totalPages;
            }

            <a class="mb-page-btn @(prevDisabled ? "disabled" : "")"
               asp-action="HeroBanners"
               asp-route-page="@(currentPage - 1)">
                <i class="bi bi-chevron-left"></i>
            </a>

            @for (int i = 1; i <= totalPages; i++)
            {
                if (i == 1 || i == totalPages || Math.Abs(i - currentPage) <= 1)
                {
                    <a class="mb-page-btn @(i == currentPage ? "active" : "")"
                       asp-action="HeroBanners"
                       asp-route-page="@i">
                        @i
                    </a>
                }
                else if (i == currentPage - 2 || i == currentPage + 2)
                {
                    <span class="mb-page-ellipsis">…</span>
                }
            }

            <a class="mb-page-btn @(nextDisabled ? "disabled" : "")"
               asp-action="HeroBanners"
               asp-route-page="@(currentPage + 1)">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>
}