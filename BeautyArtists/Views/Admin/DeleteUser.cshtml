@model BeautyArtists.Models.ApplicationUser
@{
    ViewData["Title"] = "Delete User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .du-eyebrow {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,215,0,0.35);
            display: block;
            margin-bottom: 4px;
        }

        .du-heading {
            font-size: 1.5rem;
            font-weight: 900;
            color: #ff5555;
            margin: 0 0 24px;
        }

        .du-card {
            background: #0b0b0b;
            border: 1px solid rgba(179,0,0,0.3);
            border-radius: 18px;
            overflow: hidden;
            max-width: 560px;
            width: 100%;
        }

        .du-card-header {
            background: linear-gradient(135deg, #1a0000, #2a0500);
            border-bottom: 1px solid rgba(179,0,0,0.2);
            padding: 18px 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .du-card-header-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #b30000, #ff3333);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            color: #fff;
            flex-shrink: 0;
        }

        .du-card-header-title {
            font-size: 0.85rem;
            font-weight: 800;
            color: #ff5555;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin: 0;
        }

        .du-card-header-sub {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.3);
            margin: 2px 0 0;
        }

        .du-card-body {
            padding: 24px;
        }

        /* ── WARNING BOX ── */
        .du-warning {
            background: rgba(179,0,0,0.1);
            border: 1px solid rgba(179,0,0,0.3);
            border-left: 4px solid #b30000;
            border-radius: 10px;
            padding: 16px 18px;
            margin-bottom: 24px;
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .du-warning-icon {
            color: #ff5555;
            font-size: 1.2rem;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .du-warning-text {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.75);
            line-height: 1.6;
            margin: 0;
        }

        /* ── USER CARD ── */
        .du-user-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,215,0,0.1);
            border-radius: 12px;
            padding: 16px 18px;
            margin-bottom: 24px;
        }

        .du-user-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            font-size: 0.85rem;
        }

            .du-user-row:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

            .du-user-row:first-child {
                padding-top: 0;
            }

        .du-user-label {
            color: rgba(255,215,0,0.5);
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            flex-shrink: 0;
        }

        .du-user-value {
            color: #eaeaea;
            font-weight: 600;
            text-align: right;
            word-break: break-word;
        }

        /* ── ACTIONS ── */
        .du-actions {
            display: flex;
            gap: 10px;
        }

        .du-btn-delete {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 28px;
            border-radius: 999px;
            background: linear-gradient(135deg, #8b0000, #ff3333);
            color: #fff;
            font-weight: 800;
            font-size: 0.8rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            flex: 1;
        }

            .du-btn-delete:hover {
                background: linear-gradient(135deg, #ff3333, #8b0000);
                box-shadow: 0 0 22px rgba(255,51,51,0.35);
                transform: translateY(-1px);
            }

        .du-btn-cancel {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 24px;
            border-radius: 999px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.5);
            font-weight: 700;
            font-size: 0.8rem;
            text-decoration: none;
            transition: all 0.2s;
            flex: 1;
        }

            .du-btn-cancel:hover {
                background: rgba(255,255,255,0.08);
                color: rgba(255,255,255,0.8);
            }

        @@media (max-width: 600px) {
            .du-heading {
                font-size: 1.25rem;
                margin-bottom: 18px;
            }

            .du-card {
                border-radius: 14px;
            }

            .du-card-header {
                padding: 16px 18px;
            }

            .du-card-body {
                padding: 18px;
            }

            .du-user-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 2px;
            }

            .du-user-value {
                text-align: left;
            }

            .du-actions {
                flex-direction: column;
                gap: 8px;
            }

            .du-btn-delete,
            .du-btn-cancel {
                width: 100%;
                padding: 12px;
                font-size: 0.78rem;
            }
        }
    </style>
}

<div class="container-fluid px-4">

    <span class="du-eyebrow">Administration</span>
    <h1 class="du-heading">Delete User</h1>

    <div class="du-card">
        <div class="du-card-header">
            <div class="du-card-header-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <p class="du-card-header-title">Confirm Deletion</p>
                <p class="du-card-header-sub">This action cannot be undone</p>
            </div>
        </div>

        <div class="du-card-body">

            @* ── WARNING ── *@
            <div class="du-warning">
                <i class="bi bi-exclamation-octagon-fill du-warning-icon"></i>
                <p class="du-warning-text">
                    Deleting this user will permanently remove their account and all related data.
                    This action <strong style="color:#ff5555;">cannot be undone</strong>.
                </p>
            </div>

            @* ── USER DETAILS ── *@
            <div class="du-user-card">
                <div class="du-user-row">
                    <span class="du-user-label">Full Name</span>
                    <span class="du-user-value">@Model.FirstName @Model.LastName</span>
                </div>
                <div class="du-user-row">
                    <span class="du-user-label">Email</span>
                    <span class="du-user-value">@Model.Email</span>
                </div>
            </div>

            @* ── ACTIONS ── *@
            <form asp-action="DeleteUser" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="du-actions">
                    <button type="submit" class="du-btn-delete">
                        <i class="bi bi-trash3-fill"></i> Yes, Delete
                    </button>
                    <a asp-action="ManageUsers" class="du-btn-cancel">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>