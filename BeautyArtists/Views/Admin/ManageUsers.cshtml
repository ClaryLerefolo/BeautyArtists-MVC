@model BeautyArtists.Models.ViewModels.UserManagementViewModel

@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var searchTerm = ViewBag.Search as string ?? "";
    var roleFilter = ViewBag.Role as string ?? "";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var showingFrom = ViewBag.ShowingFrom as int? ?? 0;
    var showingTo = ViewBag.ShowingTo as int? ?? 0;
    int totalUsers = ViewBag.TotalUsers as int? ?? 0;
    int totalAdmins = ViewBag.TotalAdmins as int? ?? 0;
    int totalArtists = ViewBag.TotalArtists as int? ?? 0;
    int totalClients = ViewBag.TotalClients as int? ?? 0;
}

@section Styles {
    <style>
        /* ── HEADERS ── */
        .mu-eyebrow {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,215,0,0.35);
            display: block;
            margin-bottom: 4px;
        }

        .mu-heading {
            font-size: 1.5rem;
            font-weight: 900;
            color: #FFD700;
            margin: 0 0 24px;
        }

        /* ── MINI STATS ── */
        .mu-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 12px;
            margin-bottom: 24px;
        }

        .mu-stat {
            background: #0b0b0b;
            border: 1px solid rgba(255,215,0,0.1);
            border-radius: 12px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .mu-stat-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255,215,0,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            color: #FFD700;
            flex-shrink: 0;
        }

        .mu-stat-num {
            display: block;
            font-size: 1.3rem;
            font-weight: 900;
            color: #FFD700;
            line-height: 1;
        }

        .mu-stat-label {
            display: block;
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            margin-top: 2px;
        }

        /* ── FILTER BAR ── */
        .mu-filter-bar {
            background: #0b0b0b;
            border: 1px solid rgba(255,215,0,0.1);
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 20px;
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .mu-search-wrap {
            flex: 1;
            min-width: 200px;
            position: relative;
        }

            .mu-search-wrap i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255,215,0,0.4);
                font-size: 0.85rem;
                pointer-events: none;
            }

        .mu-search-input {
            width: 100%;
            background: rgba(255,255,255,0.04) !important;
            border: 1px solid rgba(255,215,0,0.15) !important;
            border-radius: 8px !important;
            color: #fff !important;
            padding: 8px 12px 8px 36px !important;
            font-size: 0.83rem;
        }

            .mu-search-input:focus {
                outline: none;
                border-color: rgba(255,215,0,0.4) !important;
                background: rgba(255,215,0,0.03) !important;
                box-shadow: none !important;
            }

            .mu-search-input::placeholder {
                color: rgba(255,255,255,0.25) !important;
            }

        .mu-select {
            background: rgba(255,255,255,0.04) !important;
            border: 1px solid rgba(255,215,0,0.15) !important;
            border-radius: 8px !important;
            color: #fff !important;
            padding: 8px 14px !important;
            font-size: 0.83rem;
            min-width: 140px;
        }

            .mu-select option {
                background: #111;
                color: #fff;
            }

        .mu-filter-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 20px;
            border-radius: 8px;
            background: linear-gradient(135deg, #b30000, #FFD700);
            color: #000;
            font-weight: 800;
            font-size: 0.78rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            white-space: nowrap;
        }

            .mu-filter-btn:hover {
                background: linear-gradient(135deg, #FFD700, #b30000);
                box-shadow: 0 0 16px rgba(255,215,0,0.25);
            }

        .mu-danger-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 18px;
            border-radius: 8px;
            background: rgba(179,0,0,0.15);
            border: 1px solid rgba(179,0,0,0.3);
            color: #ff6666;
            font-weight: 700;
            font-size: 0.78rem;
            cursor: pointer;
            white-space: nowrap;
        }

            .mu-danger-btn:hover {
                background: rgba(179,0,0,0.3);
                color: #ff8888;
            }

        /* ── TABLE WRAP ── */
        .mu-table-wrap {
            background: #0b0b0b;
            border: 1px solid rgba(255,215,0,0.1);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .mu-table-header {
            padding: 14px 20px;
            border-bottom: 1px solid rgba(255,215,0,0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }

        .mu-table-title {
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.5);
        }

            .mu-table-title i {
                color: #FFD700;
                margin-right: 8px;
            }

        .mu-count {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.25);
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 2px 10px;
        }

        .mu-table {
            width: 100%;
            border-collapse: collapse;
        }

            .mu-table thead tr {
                background: rgba(255,215,0,0.04);
                border-bottom: 1px solid rgba(255,215,0,0.08);
            }

            .mu-table th {
                padding: 11px 20px;
                font-size: 0.68rem;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                color: rgba(255,215,0,0.4);
                text-align: left;
            }

            .mu-table td {
                padding: 12px 20px;
                font-size: 0.83rem;
                color: rgba(255,255,255,0.65);
                border-bottom: 1px solid rgba(255,255,255,0.04);
                vertical-align: middle;
            }

            .mu-table tr:last-child td {
                border-bottom: none;
            }

            .mu-table tbody tr:hover td {
                background: rgba(255,215,0,0.02);
            }

        .mu-name {
            color: #fff;
            font-weight: 600;
        }

        .mu-email {
            color: rgba(255,255,255,0.4);
            font-size: 0.8rem;
            word-break: break-all;
        }

        /* ── ROLE BADGES ── */
        .mu-role {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.68rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .mu-role-admin {
            background: rgba(179,0,0,0.2);
            color: #ff6666;
            border: 1px solid rgba(179,0,0,0.35);
        }

        .mu-role-artist {
            background: rgba(255,215,0,0.12);
            color: #FFD700;
            border: 1px solid rgba(255,215,0,0.25);
        }

        .mu-role-client {
            background: rgba(255,255,255,0.06);
            color: rgba(255,255,255,0.55);
            border: 1px solid rgba(255,255,255,0.1);
        }

        /* ── ACTION BUTTONS ── */
        .mu-btn-details,
        .mu-btn-delete,
        .mu-btn-activate,
        .mu-btn-resend,
        .mu-btn-disabled {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 7px;
            font-size: 0.75rem;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            white-space: nowrap;
        }

        .mu-btn-details {
            background: rgba(255,215,0,0.1);
            color: #FFD700;
            border: 1px solid rgba(255,215,0,0.2);
        }

            .mu-btn-details:hover {
                background: rgba(255,215,0,0.18);
                color: #FFD700;
                border-color: rgba(255,215,0,0.4);
            }

        .mu-btn-delete {
            background: rgba(179,0,0,0.12);
            color: #ff6666;
            border: 1px solid rgba(179,0,0,0.25);
        }

            .mu-btn-delete:hover {
                background: rgba(179,0,0,0.25);
                color: #ff8888;
                border-color: rgba(179,0,0,0.4);
            }

        .mu-btn-activate {
            background: rgba(40,167,69,0.12);
            color: #28a745;
            border: 1px solid rgba(40,167,69,0.25);
        }

            .mu-btn-activate:hover {
                background: rgba(40,167,69,0.22);
                color: #3cdd6b;
            }

        .mu-btn-resend {
            background: rgba(255,165,0,0.12);
            color: #ffa500;
            border: 1px solid rgba(255,165,0,0.28);
        }

            .mu-btn-resend:hover {
                background: rgba(255,165,0,0.25);
                color: #ffc04d;
                border-color: rgba(255,165,0,0.5);
            }

        .mu-btn-disabled {
            background: rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.2);
            border: 1px solid rgba(255,255,255,0.06);
            cursor: not-allowed;
        }

        .mu-actions-wrap {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        /* ── EMPTY STATE ── */
        .mu-empty {
            padding: 48px 20px;
            text-align: center;
            color: rgba(255,255,255,0.25);
            font-size: 0.85rem;
        }

            .mu-empty i {
                font-size: 2rem;
                color: rgba(255,215,0,0.15);
                display: block;
                margin-bottom: 12px;
            }

        /* ── PAGINATION ── */
        .mu-pager {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            padding: 16px 20px;
            border-top: 1px solid rgba(255,215,0,0.08);
            background: rgba(255,215,0,0.02);
        }

        .mu-pager-info {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.35);
        }

            .mu-pager-info strong {
                color: #FFD700;
                font-weight: 700;
            }

        .mu-pager-controls {
            display: flex;
            gap: 4px;
            align-items: center;
            flex-wrap: wrap;
        }

        .mu-page-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
            padding: 0 10px;
            border-radius: 7px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,215,0,0.1);
            color: rgba(255,255,255,0.6);
            font-size: 0.78rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s;
        }

            .mu-page-btn:hover {
                background: rgba(255,215,0,0.1);
                color: #FFD700;
                border-color: rgba(255,215,0,0.3);
            }

            .mu-page-btn.active {
                background: #FFD700;
                color: #000;
                border-color: #FFD700;
                box-shadow: 0 0 12px rgba(255,215,0,0.25);
            }

            .mu-page-btn.disabled {
                opacity: 0.3;
                pointer-events: none;
                cursor: not-allowed;
            }

        .mu-page-ellipsis {
            padding: 0 6px;
            color: rgba(255,255,255,0.25);
            font-size: 0.8rem;
        }

        /* ══════════════════════════════════════════════
               MOBILE RESPONSIVE  (<= 768px)
               Table turns into stacked cards
               ══════════════════════════════════════════════ */
        @@media (max-width: 768px) {
            .mu-heading {
                font-size: 1.25rem;
                margin-bottom: 18px;
            }
            /* Stats stack full-width */
            .mu-stats {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .mu-stat {
                padding: 12px 14px;
            }

            .mu-stat-num {
                font-size: 1.1rem;
            }
            /* Filter bar stacks everything */
            .mu-filter-bar {
                flex-direction: column;
                align-items: stretch;
                padding: 14px;
                gap: 10px;
            }

            .mu-search-wrap,
            .mu-select,
            .mu-filter-btn,
            .mu-danger-btn {
                width: 100%;
                min-width: 0;
                justify-content: center;
            }
            /* Hide table headers */
            .mu-table thead {
                display: none;
            }
            /* Table rows become cards */
            .mu-table,
            .mu-table tbody,
            .mu-table tr,
            .mu-table td {
                display: block;
                width: 100%;
            }

            .mu-table {
                padding: 0;
            }

                .mu-table tr {
                    background: #0f0f0f;
                    border: 1px solid rgba(255,215,0,0.1);
                    border-radius: 14px;
                    padding: 16px;
                    margin: 12px;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
                }

                    .mu-table tr:last-child {
                        margin-bottom: 12px;
                    }

                .mu-table td {
                    padding: 10px 0;
                    border-bottom: 1px solid rgba(255,255,255,0.05);
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 12px;
                    font-size: 0.83rem;
                    text-align: right;
                }

                    .mu-table td:first-child {
                        padding-top: 0;
                    }

                    .mu-table td:last-child {
                        border-bottom: none;
                        padding-bottom: 0;
                        flex-direction: column;
                        align-items: stretch;
                        text-align: left;
                        padding-top: 14px;
                        margin-top: 6px;
                        border-top: 1px solid rgba(255,215,0,0.1);
                    }
                    /* Show the label before the value */
                    .mu-table td::before {
                        content: attr(data-label);
                        font-size: 0.6rem;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                        text-transform: uppercase;
                        color: rgba(255,215,0,0.4);
                        text-align: left;
                        flex-shrink: 0;
                    }

                    .mu-table td:last-child::before {
                        margin-bottom: 10px;
                        display: block;
                    }

            .mu-name {
                font-size: 0.95rem;
            }
            /* Actions stack vertically, full width */
            .mu-actions-wrap {
                display: flex;
                flex-direction: column;
                gap: 8px;
                width: 100%;
            }

                .mu-actions-wrap > *,
                .mu-actions-wrap > form > *,
                .mu-actions-wrap > a,
                .mu-actions-wrap > span {
                    width: 100%;
                }

                .mu-actions-wrap > form {
                    margin: 0 !important;
                    width: 100%;
                }

                    .mu-actions-wrap > form > button {
                        width: 100%;
                        justify-content: center;
                        padding: 10px 12px;
                    }

            .mu-btn-details,
            .mu-btn-delete,
            .mu-btn-activate,
            .mu-btn-resend,
            .mu-btn-disabled {
                width: 100%;
                justify-content: center;
                padding: 10px 12px;
                font-size: 0.78rem;
            }
            /* Pager stacks */
            .mu-pager {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
                padding: 14px;
            }

            .mu-pager-info {
                text-align: center;
            }

            .mu-pager-controls {
                justify-content: center;
            }

            .mu-table-header {
                padding: 12px 16px;
            }
        }

        @@media (max-width: 420px) {
            .mu-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<span class="mu-eyebrow">Administration</span>
<h1 class="mu-heading">User Management</h1>

@* ── MINI STATS ── *@
<div class="mu-stats">
    <div class="mu-stat">
        <div class="mu-stat-icon"><i class="bi bi-people-fill"></i></div>
        <div>
            <span class="mu-stat-num">@totalUsers</span>
            <span class="mu-stat-label">Total Users</span>
        </div>
    </div>
    <div class="mu-stat">
        <div class="mu-stat-icon"><i class="bi bi-scissors"></i></div>
        <div>
            <span class="mu-stat-num">@totalArtists</span>
            <span class="mu-stat-label">Artists</span>
        </div>
    </div>
    <div class="mu-stat">
        <div class="mu-stat-icon"><i class="bi bi-person-heart"></i></div>
        <div>
            <span class="mu-stat-num">@totalClients</span>
            <span class="mu-stat-label">Clients</span>
        </div>
    </div>
    <div class="mu-stat">
        <div class="mu-stat-icon" style="background:rgba(179,0,0,0.12)">
            <i class="bi bi-shield-fill" style="color:#ff6666"></i>
        </div>
        <div>
            <span class="mu-stat-num" style="color:#ff6666">@totalAdmins</span>
            <span class="mu-stat-label">Admins</span>
        </div>
    </div>
</div>

@* ── FILTER BAR ── *@
<form method="get" class="mu-filter-bar">
    <div class="mu-search-wrap">
        <i class="bi bi-search"></i>
        <input type="text" name="search" value="@searchTerm"
               class="mu-search-input" placeholder="Search by name or email..." />
    </div>
    <select name="role" class="mu-select">
        <option value="" selected="@(string.IsNullOrEmpty(roleFilter) ? "selected" : null)">All Roles</option>
        <option value="Admin" selected="@(roleFilter == "Admin" ? "selected" : null)">Admin</option>
        <option value="Artist" selected="@(roleFilter == "Artist" ? "selected" : null)">Artist</option>
        <option value="Client" selected="@(roleFilter == "Client" ? "selected" : null)">Client</option>
    </select>
    <button type="submit" class="mu-filter-btn">
        <i class="bi bi-funnel-fill"></i> Filter
    </button>
</form>

@* ── DELETE PROMOTED ADMINS ── *@
<div style="margin-bottom: 16px;">
    <form asp-action="DeletePromotedAdmins" method="post" style="margin:0;display:inline-block;">
        @Html.AntiForgeryToken()
        <button type="submit" class="mu-danger-btn"
                onclick="return confirm('Delete all promoted admins? This cannot be undone.')">
            <i class="bi bi-trash3-fill"></i> Delete Promoted Admins
        </button>
    </form>
</div>

@* ── TABLE ── *@
<div class="mu-table-wrap">
    <div class="mu-table-header">
        <span class="mu-table-title">
            <i class="bi bi-people-fill"></i> Users
        </span>
        <span class="mu-count">@totalCount result@(totalCount != 1 ? "s" : "")</span>
    </div>

    @if (!Model.Users.Any())
    {
        <div class="mu-empty">
            <i class="bi bi-person-x"></i>
            No users match your search.
        </div>
    }
    else
    {
        <table class="mu-table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="mu-name" data-label="Name">@user.FullName</td>
                        <td class="mu-email" data-label="Email">@user.Email</td>
                        <td data-label="Role">
                            @if (user.Role == "Admin")
                            {
                                <span class="mu-role mu-role-admin"><i class="bi bi-shield-fill"></i> Admin</span>
                            }
                            else if (user.Role == "Artist")
                            {
                                <span class="mu-role mu-role-artist"><i class="bi bi-scissors"></i> Artist</span>
                            }
                            else
                            {
                                <span class="mu-role mu-role-client"><i class="bi bi-person-fill"></i> Client</span>
                            }
                        </td>
                        <td data-label="Actions">
                            <div class="mu-actions-wrap">
                                <a class="mu-btn-details" asp-action="UserDetails" asp-route-id="@user.Id">
                                    <i class="bi bi-eye-fill"></i> Details
                                </a>

                                @if (!user.IsEmailConfirmed)
                                {
                                    <form asp-action="ResendConfirmation" asp-route-id="@user.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="mu-btn-resend"
                                                onclick="return confirm('Send a new confirmation email to @user.Email?')">
                                            <i class="bi bi-envelope-fill"></i> Resend
                                        </button>
                                    </form>
                                }

                                @if (user.Role != "Admin")
                                {
                                    <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        @if (user.IsDeactivated)
                                        {
                                            <button type="submit" class="mu-btn-activate">
                                                <i class="bi bi-person-check-fill"></i> Activate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="mu-btn-delete"
                                                    style="background: rgba(255,165,0,0.12); color: #ffa500; border-color: rgba(255,165,0,0.25);">
                                                <i class="bi bi-person-x-fill"></i> Deactivate
                                            </button>
                                        }
                                    </form>

                                    <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="mu-btn-delete"
                                                onclick="return confirm('Delete @user.FullName? This cannot be undone.')">
                                            <i class="bi bi-trash3-fill"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="mu-btn-disabled">
                                        <i class="bi bi-lock-fill"></i> Protected
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ── PAGINATION ── *@
    @if (totalPages > 1)
    {
        <div class="mu-pager">
            <div class="mu-pager-info">
                Showing <strong>@showingFrom</strong> – <strong>@showingTo</strong> of <strong>@totalCount</strong>
            </div>
            <div class="mu-pager-controls">
                @{
                    var prevDisabled = currentPage <= 1;
                    var nextDisabled = currentPage >= totalPages;
                }

                <a class="mu-page-btn @(prevDisabled ? "disabled" : "")"
                   asp-action="ManageUsers"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-search="@searchTerm"
                   asp-route-role="@roleFilter">
                    <i class="bi bi-chevron-left"></i>
                </a>

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == 1 || i == totalPages || Math.Abs(i - currentPage) <= 1)
                    {
                        <a class="mu-page-btn @(i == currentPage ? "active" : "")"
                           asp-action="ManageUsers"
                           asp-route-page="@i"
                           asp-route-search="@searchTerm"
                           asp-route-role="@roleFilter">
                            @i
                        </a>
                    }
                    else if (i == currentPage - 2 || i == currentPage + 2)
                    {
                        <span class="mu-page-ellipsis">…</span>
                    }
                }

                <a class="mu-page-btn @(nextDisabled ? "disabled" : "")"
                   asp-action="ManageUsers"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-search="@searchTerm"
                   asp-route-role="@roleFilter">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    }
</div>