@model BeautyArtists.Models.Booking
@using static BeautyArtists.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var serviceName = Model.UserService?.Service?.Name ?? "Unknown Service";
    var customerName = Model.Customer?.FullName ?? "Unknown Customer";
    var artistName = Model.UserService?.Artist?.FullName ?? "Unknown Artist";
    var artistEmail = Model.UserService?.Artist?.Email ?? "";
    var customerEmail = Model.Customer?.Email ?? "";
    var statusClass = Model.Status.ToString().ToLower();
}

@section Styles {
    <style>
        .bd-eyebrow {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,215,0,0.35);
            display: block;
            margin-bottom: 4px;
        }

        .bd-heading {
            font-size: 1.6rem;
            font-weight: 900;
            color: #FFD700;
            margin: 0 0 6px;
            line-height: 1.2;
        }

        .bd-subheading {
            font-size: 0.82rem;
            color: rgba(255,255,255,0.35);
            margin: 0 0 24px;
        }

        /* ── STATUS BADGE ── */
        .bd-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 5px 14px;
            border-radius: 20px;
            margin-bottom: 24px;
        }

        .bd-status-pending {
            background: rgba(240,200,8,0.15);
            color: #f0c808;
            border: 1px solid rgba(240,200,8,0.3);
        }

        .bd-status-accepted {
            background: rgba(23,162,184,0.15);
            color: #17a2b8;
            border: 1px solid rgba(23,162,184,0.3);
        }

        .bd-status-confirmed {
            background: rgba(0,200,83,0.15);
            color: #00c853;
            border: 1px solid rgba(0,200,83,0.3);
        }

        .bd-status-completed {
            background: rgba(0,123,255,0.15);
            color: #3b8cff;
            border: 1px solid rgba(0,123,255,0.3);
        }

        .bd-status-cancelled {
            background: rgba(229,9,20,0.15);
            color: #ff5555;
            border: 1px solid rgba(229,9,20,0.3);
        }

        .bd-status-rejected {
            background: rgba(108,117,125,0.2);
            color: #adb5bd;
            border: 1px solid rgba(108,117,125,0.35);
        }

        .bd-status-disputed {
            background: rgba(229,9,20,0.15);
            color: #ff5555;
            border: 1px solid rgba(229,9,20,0.3);
        }

        .bd-status-inreview {
            background: rgba(255,140,0,0.15);
            color: #ff8c00;
            border: 1px solid rgba(255,140,0,0.3);
        }

        .bd-status-resolved {
            background: rgba(40,167,69,0.15);
            color: #28a745;
            border: 1px solid rgba(40,167,69,0.3);
        }

        /* ── GRID ── */
        .bd-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 24px;
        }

        /* ── CARD ── */
        .bd-card {
            background: #0b0b0b;
            border: 1px solid rgba(255,215,0,0.1);
            border-radius: 14px;
            padding: 20px;
        }

        .bd-card-label {
            font-size: 0.6rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,215,0,0.4);
            margin-bottom: 10px;
            display: block;
        }

        .bd-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            font-size: 0.85rem;
        }

            .bd-row:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

            .bd-row:first-of-type {
                padding-top: 0;
            }

        .bd-row-label {
            color: rgba(255,255,255,0.45);
        }

        .bd-row-value {
            color: #eaeaea;
            font-weight: 500;
            text-align: right;
            word-break: break-word;
        }

            .bd-row-value.muted {
                color: rgba(255,255,255,0.4);
                font-weight: 400;
            }

            .bd-row-value.gold {
                color: #FFD700;
                font-weight: 700;
            }

            .bd-row-value.ruby {
                color: #ff5555;
                font-weight: 700;
            }

        /* ── STATUS UPDATE FORM ── */
        .bd-form-card {
            background: #0b0b0b;
            border: 1px solid rgba(255,215,0,0.15);
            border-radius: 14px;
            padding: 22px;
        }

        .bd-form-title {
            font-size: 0.9rem;
            font-weight: 800;
            color: #FFD700;
            margin: 0 0 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .bd-form-sub {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.4);
            margin: 0 0 18px;
        }

        .bd-select {
            width: 100%;
            background: rgba(255,255,255,0.04) !important;
            border: 1px solid rgba(255,215,0,0.15) !important;
            border-radius: 8px !important;
            color: #fff !important;
            padding: 10px 14px !important;
            font-size: 0.85rem;
            margin-bottom: 14px;
        }

            .bd-select:focus {
                outline: none;
                border-color: rgba(255,215,0,0.4) !important;
                box-shadow: none !important;
            }

            .bd-select option {
                background: #111;
                color: #fff;
            }

        .bd-submit-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #b30000, #FFD700);
            color: #000;
            font-weight: 800;
            font-size: 0.8rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.25s;
        }

            .bd-submit-btn:hover {
                background: linear-gradient(135deg, #FFD700, #b30000);
                box-shadow: 0 0 20px rgba(255,215,0,0.3);
                transform: translateY(-1px);
            }

        /* ── ALERTS ── */
        .bd-alert {
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 0.83rem;
            font-weight: 600;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .bd-alert-success {
            background: rgba(0,200,83,0.1);
            border: 1px solid rgba(0,200,83,0.3);
            color: #00c853;
        }

        .bd-alert-error {
            background: rgba(255,50,50,0.08);
            border: 1px solid rgba(255,50,50,0.25);
            color: #ff5555;
        }

        /* ── BACK BUTTON ── */
        .bd-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 20px;
            color: rgba(255,215,0,0.6);
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s;
        }

            .bd-back:hover {
                color: #FFD700;
            }

        /* ══════════════════════════════
               MOBILE (<= 768px)
               ══════════════════════════════ */
        @@media (max-width: 768px) {
            .bd-heading {
                font-size: 1.3rem;
            }

            .bd-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .bd-card {
                padding: 16px;
            }

            .bd-form-card {
                padding: 18px;
            }

            .bd-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 2px;
            }

            .bd-row-value {
                text-align: left;
            }
        }
    </style>
}

<div class="container-fluid px-4">

    @* ── HEADER ── *@
    <span class="bd-eyebrow">Booking</span>
    <h1 class="bd-heading">@serviceName</h1>
    <p class="bd-subheading">Booking #@Model.Id · Scheduled @Model.AppointmentDate.ToString("dddd, dd MMM yyyy 'at' HH:mm")</p>

    <span class="bd-status bd-status-@statusClass">
        <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i>
        @Model.Status
    </span>

    @* ── ALERTS ── *@
    @if (TempData["Success"] != null)
    {
        <div class="bd-alert bd-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bd-alert bd-alert-error">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Error"]
        </div>
    }

    @* ── INFO CARDS ── *@
    <div class="bd-grid">

        @* Customer *@
        <div class="bd-card">
            <span class="bd-card-label">Customer</span>
            <div class="bd-row">
                <span class="bd-row-label">Name</span>
                <span class="bd-row-value">@customerName</span>
            </div>
            <div class="bd-row">
                <span class="bd-row-label">Email</span>
                <span class="bd-row-value muted">@customerEmail</span>
            </div>
        </div>

        @* Artist *@
        <div class="bd-card">
            <span class="bd-card-label">Artist</span>
            <div class="bd-row">
                <span class="bd-row-label">Name</span>
                <span class="bd-row-value">@artistName</span>
            </div>
            <div class="bd-row">
                <span class="bd-row-label">Email</span>
                <span class="bd-row-value muted">@artistEmail</span>
            </div>
        </div>

        @* Booking *@
        <div class="bd-card">
            <span class="bd-card-label">Booking</span>
            <div class="bd-row">
                <span class="bd-row-label">Service</span>
                <span class="bd-row-value">@serviceName</span>
            </div>
            <div class="bd-row">
                <span class="bd-row-label">Appointment</span>
                <span class="bd-row-value">@Model.AppointmentDate.ToString("dd MMM yyyy, HH:mm")</span>
            </div>
            <div class="bd-row">
                <span class="bd-row-label">Location Type</span>
                <span class="bd-row-value">@Model.SelectedLocationType</span>
            </div>
        </div>

        @* Payment *@
        <div class="bd-card">
            <span class="bd-card-label">Payment</span>
            <div class="bd-row">
                <span class="bd-row-label">Service Price</span>
                <span class="bd-row-value">R @Model.ServicePrice.ToString("N2")</span>
            </div>
            <div class="bd-row">
                <span class="bd-row-label">Deposit Paid</span>
                <span class="bd-row-value @(Model.IsDepositPaid ? "gold" : "muted")">
                    R @Model.DepositPaid.ToString("N2")
                </span>
            </div>
            <div class="bd-row">
                <span class="bd-row-label">Final Paid</span>
                <span class="bd-row-value @(Model.FinalPaymentPaid > 0 ? "gold" : "muted")">
                    R @Model.FinalPaymentPaid.ToString("N2")
                </span>
            </div>
            <div class="bd-row">
                <span class="bd-row-label">Total Amount</span>
                <span class="bd-row-value gold">R @Model.TotalAmount.ToString("N2")</span>
            </div>
            @if (Model.IsRefunded)
            {
                <div class="bd-row">
                    <span class="bd-row-label">Refunded</span>
                    <span class="bd-row-value ruby">R @Model.RefundAmount.ToString("N2")</span>
                </div>
            }
        </div>

    </div>

    @* ── STATUS UPDATE FORM ── *@
    <div class="bd-form-card">
        <h3 class="bd-form-title">
            <i class="bi bi-sliders"></i> Admin Override
        </h3>
        <p class="bd-form-sub">Force the booking status. This action is logged in the audit trail.</p>

        <form asp-action="AdminOverride" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookingId" value="@Model.Id" />

            <select class="bd-select" name="newStatus" id="newStatus">
                @foreach (var status in Enum.GetValues(typeof(BookingStatus)))
                {
                    var statusString = status.ToString();
                    var isSelected = statusString == Model.Status.ToString();

                    <option value="@statusString" selected="@(isSelected ? "selected" : null)">
                        @statusString
                    </option>
                }
            </select>

            <button type="submit" class="bd-submit-btn"
                    onclick="return confirm('Force status change for booking #@Model.Id?');">
                <i class="bi bi-check-circle-fill"></i> Update Status
            </button>
        </form>
    </div>

    @* ── BACK LINK ── *@
    <a asp-action="ManageBookings" class="bd-back">
        <i class="bi bi-arrow-left"></i> Back to Bookings
    </a>

</div>